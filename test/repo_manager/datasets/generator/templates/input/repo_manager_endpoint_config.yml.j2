# ***********************************************************************
# REPO MANAGER ENDPOINT CONFIGURATION
# ***********************************************************************
# This file configures the Pulp repository server endpoint used by repo_manager.
# ***********************************************************************

# =============================================================================
# PULP SERVER ENDPOINT
# =============================================================================

# Pulp server port
pulp_server_port: {{ pulp_server_port | default(2225) }}

# Pulp protocol: "https"
pulp_protocol: "https"

# Enable HTTPS
pulp_https_enabled: true

# =============================================================================
# SSL CERTIFICATES
# =============================================================================
# These paths are under OMNIA_DATA_PATH/pulp_config/ (/opt/omnia/pulp_config by default).
# Modify only if using a custom OMNIA_DATA_PATH or certificate location.

ssl_certificates:
  server_crt: "{{ pulp_server_crt | default('/opt/omnia/pulp_config/pulp/settings/certs/pulp_webserver.crt') }}"
  server_key: "{{ pulp_server_key | default('/opt/omnia/pulp_config/pulp/settings/certs/pulp_webserver.key') }}"
  certs_dir: "{{ pulp_certs_dir | default('/opt/omnia/pulp_config/pulp/settings/certs') }}"