---

# Repo Manager credentials

# Pulp admin credentials for Pulp container access
# Required for setting up and managing the Pulp repository server
pulp_username: "{{ pulp_username | default('') }}"
pulp_password: "{{ pulp_password | default('') }}"

# Docker Hub credentials for accessing container registries
# Leave empty if Docker Hub authentication is not required
docker_username: "{{ docker_username | default('') }}"
docker_password: "{{ docker_password | default('') }}"

# Private container registry credentials used for user_registry images
# Each entry requires host, username, and password.
# cert_path and key_path are optional and only needed for HTTPS with client certs.
user_registry_credentials: {{ user_registry_credentials | default([]) }}