# =============================================================================
# Orchestrator — Orchestrator Config (Generated from Template)
# =============================================================================

---
pxe_mapping_file_path: "{{ pxe_mapping_file_path }}"
language: "{{ language }}"
default_lease_time: "{{ default_lease_time }}"
dns_enabled: {{ dns_enabled | lower }}
kernel_version_override: "{{ kernel_version_override }}"
additional_cloud_init_config_file: "{{ additional_cloud_init_config_file }}"
boot_kernel_params: "{{ boot_kernel_params }}"
catalog_file_path: "{{ catalog_file_path }}"
image_build_manager_output_path: "{{ image_build_manager_output_path }}"
repo_manager_output_path: "{{ repo_manager_output_path }}"
dcgm_enabled: {{ dcgm_enabled | lower }}

# =============================================================================
# Functional Groups (for SLURM testing)
# =============================================================================
functional_groups:
  - name: "slurm_control_node"
    description: "SLURM control nodes"
  - name: "slurm_node"
    description: "SLURM compute nodes"
  - name: "login"
    description: "Login nodes"
  - name: "login_compiler"
    description: "Login compiler nodes"
