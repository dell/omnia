# PXE Boot Configuration
# This file configures PXE boot and node-registration verification timing
#
# Usage:
#   - To run PXE boot: ansible-playbook orchestrator.yml --tags pxeboot
#   - Standalone: ansible-playbook pxeboot/pxeboot.yml

# ─────────────────────────────────────────────────────────────────────────
# Node-Registration Verification Configuration
# ─────────────────────────────────────────────────────────────────────────

# Enable/disable node-registration verification (default: true)
# When enabled, each node must be reachable through passwordless root SSH,
# have booted after the PXE request, and report cloud-init status "done".
# Verification is performed directly from the OIM. Metadata Service's
# /phone-home route is a WireGuard bootstrap endpoint and is not a generic
# cloud-init completion callback.
# When disabled, the playbook reports PXE initiation without claiming that the
# operating system boot or cloud-init execution was verified.
# Legacy variable name: enable_phone_home (deprecated, will be removed)
enable_node_registration: true

# Initial wait time before starting node-registration polling (in minutes)
# Nodes need time to boot and begin cloud-init before we start checking
# Recommended: 3-5 minutes for typical hardware
# Legacy variable name: phone_home_pause_minutes (deprecated, will be removed)
node_registration_pause_minutes: 3

# Maximum number of node-registration polling retries
# Approximate retry delay budget per node = retries × delay. SSH connection
# time and the initial pause are additional. Nodes are checked concurrently,
# bounded by the Ansible forks setting.
# Legacy variable name: phone_home_retries (deprecated, will be removed)
node_registration_retries: 120

# Delay between node-registration polling retries (in seconds)
# Legacy variable name: phone_home_delay (deprecated, will be removed)
node_registration_delay: 15

# ─────────────────────────────────────────────────────────────────────────
# PXE Boot Configuration (Advanced)
# ─────────────────────────────────────────────────────────────────────────

# Restart host after setting PXE boot (default: true)
# When false, only sets boot source without restarting
restart_host: true

# Use ForceRestart instead of GracefulRestart (default: true)
# ForceRestart: Immediate power cycle (faster)
# GracefulRestart: Attempts graceful OS shutdown first (safer)
force_restart: true

# Boot source override mode (default: continuous)
# Options: once, continuous, disabled
# continuous: Boot from PXE on every restart until changed
# once: Boot from PXE only once, then revert to normal boot order
boot_source_override_enabled: continuous

# Boot source override target (default: pxe)
# Options: pxe, uefi_http, hdd, cd, floppy, sd_card, utilities, bios_setup, none
boot_source_override_target: pxe
