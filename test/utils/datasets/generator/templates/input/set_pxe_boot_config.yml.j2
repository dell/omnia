---
# PXE Boot Configuration
# Generated from template with profile variables

# Phone-Home Verification Configuration
enable_phone_home: {{ enable_phone_home | lower }}
phone_home_pause_minutes: {{ phone_home_pause_minutes }}
phone_home_retries: {{ phone_home_retries }}
phone_home_delay: {{ phone_home_delay }}
phone_home_log_pattern: "{{ phone_home_log_pattern }}"

# PXE Boot Configuration
restart_host: {{ restart_host | lower }}
force_restart: {{ force_restart | lower }}
boot_source_override_enabled: "{{ boot_source_override_enabled }}"
boot_source_override_target: "{{ boot_source_override_target }}"
