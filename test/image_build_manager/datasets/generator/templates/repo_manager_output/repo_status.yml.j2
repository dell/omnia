---
{% if repo_type == "offline" %}
# ============================================================================
# repo_status.yml — repo_manager output contract
# ============================================================================
#
# This is a REFERENCE TEMPLATE. In production, repo_manager generates this file.
#
# Runtime location (created by repo_manager or copied manually):
#   /opt/omnia/repo_manager/output/<project_name>/repo_status.yml
#
# Producer: repo_manager domain (repo_manager.yml)
# Consumer: image_build_manager domain (image_build_manager.yml Step 4)
# ============================================================================

overall_status: "success"
cluster_os_type: "{{ cluster_os_type }}"
repo_config: "partial"

repo_manager:
  port: {{ pulp_port }}
  certificates:
    server_crt: "{{ pulp_server_crt }}"
    server_key: "{{ pulp_server_key }}"
    certs_dir: "{{ pulp_certs_dir }}"

repositories:
  "{{ cluster_os_version }}":
    x86_64:
{% for repo in offline_x86_all_repos %}
{% if repo in offline_x86_url_repos %}
{% set slug = repo_url_slug_overrides[repo] if repo in repo_url_slug_overrides else repo %}
      {{ repo }}:
        url: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pulp/content/offline_repo/cluster/x86_64/{{ cluster_os_type }}/{{ cluster_os_version }}/rpms/x86_64_{{ cluster_os_type }}_{{ cluster_os_version }}_{{ slug }}/"
{% else %}
      {{ repo }}: {}
{% endif %}
{% endfor %}

    aarch64:
{% for repo in offline_aarch64_all_repos %}
{% if repo in offline_aarch64_url_repos %}
{% set slug = repo_url_slug_overrides[repo] if repo in repo_url_slug_overrides else repo %}
      {{ repo }}:
        url: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pulp/content/offline_repo/cluster/aarch64/{{ cluster_os_type }}/{{ cluster_os_version }}/rpms/aarch64_{{ cluster_os_type }}_{{ cluster_os_version }}_{{ slug }}/"
{% else %}
      {{ repo }}: {}
{% endif %}
{% endfor %}

registries:
  user_registry1:
    port: 443
    tls:
      capath: "/etc/omnia/certs/my-reg.example.com/ca.crt"
      clientcertpath: "/etc/omnia/certs/my-reg.example.com/client.crt"
      clientkeypath: "/etc/omnia/certs/my-reg.example.com/client.key"
      insecure: false

  user_registry2:
    host: "{{ registry2_host }}"
    port: 443
    tls:
      capath: "/etc/omnia/certs/internal-registry/ca.crt"
      clientcertpath: "/etc/omnia/certs/internal-registry/client.crt"
      clientkeypath: "/etc/omnia/certs/internal-registry/client.key"
      insecure: false

file_repos:
  x86_64:
    git:
{% for repo in offline_git_repos %}
      {{ repo.name }}: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pulp/content/offline_repo/cluster/x86_64/{{ cluster_os_type }}/{{ cluster_os_version }}/git/{{ repo.path }}/"
{% endfor %}

    tarball:
{% for repo in offline_tarball_repos %}
      {{ repo.name }}: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pulp/content/offline_repo/cluster/x86_64/{{ cluster_os_type }}/{{ cluster_os_version }}/tarball/{{ repo.path }}/"
{% endfor %}

    manifest:
{% for repo in offline_manifest_repos %}
      {{ repo.name }}: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pulp/content/offline_repo/cluster/x86_64/{{ cluster_os_type }}/{{ cluster_os_version }}/manifest/{{ repo.path }}/"
{% endfor %}

    pip_module:
{% for repo in offline_pip_repos %}
      {{ repo.name }}: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pypi/offline_repo/cluster/x86_64/{{ cluster_os_type }}/{{ cluster_os_version }}/pip_module/{{ repo.path }}/"
{% endfor %}
  aarch64: {}

tarball_base_url: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pulp/content/offline_repo/cluster/x86_64/{{ cluster_os_type }}/{{ cluster_os_version }}/tarball/"
manifest_base_url: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pulp/content/offline_repo/cluster/x86_64/{{ cluster_os_type }}/{{ cluster_os_version }}/manifest/"
pip_base_url: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pypi/offline_repo/cluster/x86_64/{{ cluster_os_type }}/{{ cluster_os_version }}/pip_module/"
git_base_url: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pulp/content/offline_repo/cluster/x86_64/{{ cluster_os_type }}/{{ cluster_os_version }}/git/"
offline_tarball_path: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pulp/content/offline_repo/cluster/x86_64/{{ cluster_os_type }}/{{ cluster_os_version }}/tarball/"
offline_manifest_path: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pulp/content/offline_repo/cluster/x86_64/{{ cluster_os_type }}/{{ cluster_os_version }}/manifest/"
offline_pip_module_path: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pypi/offline_repo/cluster/x86_64/{{ cluster_os_type }}/{{ cluster_os_version }}/pip_module/"
offline_git_path: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pulp/content/offline_repo/cluster/x86_64/{{ cluster_os_type }}/{{ cluster_os_version }}/git/"
offline_shell_path: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pulp/content/offline_repo/cluster/x86_64/{{ cluster_os_type }}/{{ cluster_os_version }}/shell/"
offline_iso_path: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pulp/content/offline_repo/cluster/x86_64/{{ cluster_os_type }}/{{ cluster_os_version }}/iso/"
offline_ansible_galaxy_collection_path: "https://{{ '{{ admin_nic_ip }}' }}:{{ pulp_port }}/pulp/content/offline_repo/cluster/x86_64/{{ cluster_os_type }}/{{ cluster_os_version }}/ansible_galaxy_collection/"
{% else %}
# ============================================================================
# repo_status.yml — Internet-based repo URLs for testing
# ============================================================================
#
# USE CASE: Test image_build_manager independently without repo_manager.
#
# This file uses PUBLIC internet RPM repositories (CentOS Stream 10 + EPEL)
# so the image builder can resolve and install packages directly from the
# internet.  No Pulp, no repo_manager, no admin_nic_ip needed.
#
# NOTE: CentOS Stream 10 repos are binary-compatible with RHEL 10.0 and
#       are freely accessible without a subscription.  For production RHEL
#       deployments, use the subscription-based CDN URLs instead.
# ============================================================================

overall_status: "success"
cluster_os_type: "{{ cluster_os_type }}"
repo_config: "partial"

repo_manager:
  port: ""
  certificates:
    server_crt: ""
    server_key: ""
    certs_dir: ""

repositories:
  "{{ cluster_os_version }}":
{% for arch in ['x86_64', 'aarch64'] %}
    {{ arch }}:
{% for repo_name, repo_url in internet_repos[arch].items() %}
      {{ repo_name }}:
        url: "{{ repo_url }}"
{% endfor %}
      slurm_custom: {}
      ldms: {}
      additional_repos: {}
{% endfor %}

registries: {}
file_repos:
  x86_64: {}
  aarch64: {}
{% endif %}
