# =============================================================================
# package_groups.yml — RHEL RPM Package Groups (Config Mode)
# =============================================================================
#
# User-editable package mapping for image_build_manager "config" mode.
# Used when functional_groups_source: "config" in image_build_config.yml.
#
# This file is a template shipped in the source tree under input/.
# domain-init.sh copies it to the runtime project directory:
#   <OMNIA_DATA_PATH>/image_build_manager/input/<project>/package_groups.yml
#
# Structure:
#   base_packages     — RPM names installed in ALL images (the base OS layer)
#   functional_groups — dict keyed by functional group name
#     Each group has:
#       packages: list of RPM package names for that group's compute layer
#
# Naming convention (config mode): {role}_{arch}
#   e.g., slurm_node_x86_64, login_node_aarch64
#
# For catalog mode, package resolution comes from catalog JSON instead.
# See image_build_config.yml Section 5.
#
# Multi-OS support (Phase 2):
#   Each OS project directory will have its own package_groups.yml.
#   RHEL uses RPM names here; Ubuntu will use DEB names in a separate
#   input/project_ubuntu/package_groups.yml (future).
# =============================================================================

# --- OS metadata ---
# Used by image_build_manager to set cluster_os_type and cluster_os_version
# when running in config mode. For multi-OS support, each OS project directory
# will have its own package_groups.yml with the appropriate os/os_version.
os: "{{ os }}"
os_version: "{{ os_version }}"

# --- Base OS packages (installed in every image) ---
base_packages:
{% for pkg in base_packages %}
  - {{ pkg }}
{% endfor %}

# --- Functional group → RPM package mapping ---
# Each key is a functional group name (must match image_build_config.yml entries).
# Packages listed here are IN ADDITION to base_packages above.
functional_groups:

  # ---- x86_64 groups ----

  os_x86_64:
    packages: []
{% for role in ['slurm_node', 'slurm_control_node', 'login_node', 'login_compiler_node'] %}

  {{ role }}_x86_64:
    packages:
      # slurm_custom common
{% for pkg in slurm_common_packages %}
      - {{ pkg }}
{% endfor %}
      # {{ role }} role-specific
{% for pkg in group_extra_packages[role] %}
      - {{ pkg }}
{% endfor %}
      # openldap
{% for pkg in openldap_packages %}
      - {{ pkg }}
{% endfor %}
{% endfor %}

  service_kube_control_plane_first_x86_64:
    packages: []

  service_kube_control_plane_x86_64:
    packages: []

  service_kube_node_x86_64:
    packages: []

  # ---- aarch64 groups ----

  os_aarch64:
    packages: []
{% for role in ['slurm_node', 'login_node', 'login_compiler_node'] %}

  {{ role }}_aarch64:
    packages:
{% for pkg in slurm_common_packages %}
      - {{ pkg }}
{% endfor %}
{% for pkg in group_extra_packages[role] %}
      - {{ pkg }}
{% endfor %}
{% for pkg in openldap_packages %}
      - {{ pkg }}
{% endfor %}
{% endfor %}
