# ===============================================================
# omnia_build_stream Quadlet Service
# FastAPI Service for Omnia Build Stream Automation
# ===============================================================
[Unit]
Description=Omnia Build Stream FastAPI Container
After=network-online.target
Wants=network-online.target

[Container]
ContainerName={{ build_stream_container_name }}
HostName={{ build_stream_container_name }}
Image={{ build_stream_image_name }}:{{ build_stream_image_tag }}
Network=host

# Environment variables
Environment=HOST={{ build_stream_host_ip }}
Environment=PORT={{ build_stream_port }}

# Build Stream SSL certificates (for HTTPS server)
Environment=SSL_KEYFILE=/etc/ssl/omnia/bs_key.pem
Environment=SSL_CERTFILE=/etc/ssl/omnia/bs_cert.pem

# Database configuration
Environment=DATABASE_URL=postgresql://{{ postgres_user }}:{{ postgres_password }}@localhost:5432/{{ postgres_db_name }}

# MinIO credentials are held in a root-only environment file.
EnvironmentFile={{ build_stream_s3_environment_file }}

# Authentication and OAuth configuration
Environment=OMNIA_DATA_PATH={{ build_stream_container_omnia_path }}
Environment=OMNIA_PROJECT_NAME={{ project_name }}
Environment=ANSIBLE_VAULT_PASSWORD_FILE="{{ build_stream_container_omnia_path }}/build_stream/input/{{ project_name }}/.build_stream_credentials_key"
Environment=OAUTH_CLIENTS_VAULT_PATH="{{ build_stream_container_omnia_path }}/build_stream/input/{{ project_name }}/build_stream_credentials.yml"
Environment=AUTH_CONFIG_VAULT_PATH="{{ build_stream_container_omnia_path }}/build_stream/input/{{ project_name }}/build_stream_credentials.yml"
Environment=JWT_PRIVATE_KEY_PATH="{{ build_stream_container_omnia_path }}/build_stream_root/api/.auth/keys/jwt_private.pem"
Environment=JWT_PUBLIC_KEY_PATH="{{ build_stream_container_omnia_path }}/build_stream_root/api/.auth/keys/jwt_public.pem"
Environment=BUILD_STREAM_CONFIG_PATH="{{ build_stream_container_omnia_path }}/build_stream/build_stream.ini"
Environment=NFS_ARTIFACT_BASE={{ build_stream_container_omnia_path }}/build_stream_root
Environment=PLAYBOOK_QUEUE_BASE={{ build_stream_container_queue_base }}
Environment=PLAYBOOK_QUEUE_AUTH_KEY_FILE={{ build_stream_container_queue_auth_key }}
Environment=PLAYBOOK_QUEUE_API_STATE_DIR={{ build_stream_container_queue_api_state_dir }}

# Volume mounts (NFS shared path)
Volume={{ omnia_path }}:{{ build_stream_container_omnia_path }}{{ selinux_option }}
Volume={{ build_stream_queue_auth_key }}:{{ build_stream_container_queue_auth_key }}:ro{{ selinux_option | regex_replace('^:', ',') }}
Volume={{ build_stream_queue_api_state_dir }}:{{ build_stream_container_queue_api_state_dir }}:rw{{ selinux_option | regex_replace('^:', ',') }}
Volume={{ build_stream_ssl_dir }}:/etc/ssl/omnia:ro{{ selinux_option | regex_replace('^:', ',') }}
Volume={{ image_build_ca_cert }}:{{ build_stream_container_image_build_ca }}:ro{{ selinux_option | regex_replace('^:', ',') }}
Volume={{ build_stream_s3_init_script }}:{{ build_stream_container_s3_init_script }}:ro{{ selinux_option | regex_replace('^:', ',') }}

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target
