{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "build_stream_credentials",
    "description": "Schema for build_stream_credentials.yml",
    "type": "object",
    "required": ["gitlab_root_password", "gitlab_ssh_password"],
    "properties": {
        "gitlab_root_password": {
            "type": "string",
            "minLength": 1,
            "description": "GitLab root user password"
        },
        "gitlab_ssh_password": {
            "type": "string",
            "minLength": 1,
            "description": "SSH password for GitLab host"
        },
        "postgres_user": {
            "type": "string",
            "description": "PostgreSQL database user"
        },
        "postgres_password": {
            "type": "string",
            "description": "PostgreSQL database password"
        },
        "auth_registration": {
            "type": "object",
            "properties": {
                "username": {
                    "type": "string",
                    "description": "BSM API auth username"
                },
                "password": {
                    "type": "string",
                    "description": "BSM API auth password"
                }
            },
            "description": "BSM API authentication credentials"
        }
    }
}
