{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "build_stream_config",
    "description": "Schema for build_stream_config.yml",
    "type": "object",
    "required": ["enable_build_stream"],
    "properties": {
        "enable_build_stream": {
            "type": "boolean",
            "description": "Enable or disable the BuildStream CI/CD pipeline"
        },
        "build_stream_host_ip": {
            "type": "string",
            "description": "BuildStream API server host IPv4 address"
        },
        "build_stream_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "BuildStream API server port"
        },
        "gitlab_host": {
            "type": "string",
            "description": "Target host IPv4 address for GitLab deployment"
        },
        "gitlab_project_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
            "description": "GitLab project name"
        },
        "gitlab_project_visibility": {
            "type": "string",
            "enum": ["private", "internal", "public"],
            "description": "GitLab project visibility"
        },
        "gitlab_default_branch": {
            "type": "string",
            "minLength": 1,
            "description": "Default branch for GitLab repository"
        },
        "gitlab_https_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "HTTPS port for GitLab"
        },
        "gitlab_min_storage_gb": {
            "type": "integer",
            "minimum": 1,
            "description": "Minimum free disk in GB for GitLab"
        },
        "gitlab_min_memory_gb": {
            "type": "integer",
            "minimum": 1,
            "description": "Minimum memory in GB for GitLab"
        },
        "gitlab_min_cpu_cores": {
            "type": "integer",
            "minimum": 1,
            "description": "Minimum CPU cores for GitLab"
        },
        "gitlab_puma_workers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64,
            "description": "Puma web worker count"
        },
        "gitlab_sidekiq_concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "Sidekiq background job concurrency"
        },
        "cadence": {
            "type": "object",
            "description": "Cadence polling configuration for periodic package sync",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable or disable cadence polling for periodic package sync"
                },
                "interval_days": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 7,
                    "description": "Cadence polling interval in days (minimum 1 day)"
                },
                "sync_timeout_seconds": {
                    "type": "integer",
                    "minimum": 60,
                    "description": "Timeout for repo sync playbook execution"
                },
                "sync_poll_interval_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 300,
                    "description": "Poll interval while waiting for sync result"
                }
            },

            "additionalProperties": false
        },
        "retention": {
            "type": "object",
            "description": "Automatic image cleanup (age-based retention) configuration",
            "properties": {
                "auto_cleanup_enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable or disable automatic image cleanup"
                },
                "retention_age_days": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 90,
                    "description": "Age in days after which a never-deployed image group is cleaned up"
                },
                "min_keep_count": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 5,
                    "description": "Minimum number of image groups kept per functional group"
                },
                "evaluation_interval_hours": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 24,
                    "description": "Interval between automatic cleanup cycles in hours (minimum 1 hour)"
                }
            },
            "additionalProperties": false
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "enable_build_stream": {
                        "const": true
                    }
                },
                "required": ["enable_build_stream"]
            },
            "then": {
                "required": [
                    "build_stream_host_ip",
                    "build_stream_port",
                    "gitlab_host"
                ],
                "properties": {
                    "build_stream_host_ip": {
                        "minLength": 1,
                        "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$"
                    },
                    "gitlab_host": {
                        "minLength": 1,
                        "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$"
                    }
                }
            }
        }
    ],
    "additionalProperties": false
}
