{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "build_stream_config",
    "description": "Schema for build_stream_config.yml",
    "type": "object",
    "required": ["enable_build_stream"],
    "properties": {
        "enable_build_stream": {
            "type": "boolean",
            "description": "Enable or disable the BuildStream CI/CD pipeline"
        },
        "build_stream_host_ip": {
            "type": "string",
            "description": "BuildStream API server host IPv4 address"
        },
        "build_stream_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "BuildStream API server port"
        },
        "gitlab_mode": {
            "type": "string",
            "enum": ["hosted", "external"],
            "description": "GitLab deployment mode: hosted (Omnia installs GitLab in a container on the OIM) or external (customer-managed GitLab)"
        },
        "gitlab_host": {
            "type": "string",
            "description": "Target host IPv4 address for GitLab deployment (hosted mode)"
        },
        "gitlab_external_url": {
            "type": "string",
            "description": "HTTPS URL of the customer-managed GitLab (external mode)"
        },
        "gitlab_project_namespace": {
            "type": "string",
            "description": "GitLab group/namespace for the project (external mode)"
        },
        "gitlab_ca_cert_path": {
            "type": "string",
            "description": "Path to a custom CA PEM bundle for HTTPS calls to the external GitLab"
        },
        "gitlab_project_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
            "description": "GitLab project name"
        },
        "gitlab_project_visibility": {
            "type": "string",
            "enum": ["private", "internal", "public"],
            "description": "GitLab project visibility"
        },
        "gitlab_default_branch": {
            "type": "string",
            "minLength": 1,
            "description": "Default branch for GitLab repository"
        },
        "gitlab_https_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "HTTPS port for GitLab"
        },
        "gitlab_min_storage_gb": {
            "type": "integer",
            "minimum": 1,
            "description": "Minimum free disk in GB for GitLab"
        },
        "gitlab_min_memory_gb": {
            "type": "integer",
            "minimum": 1,
            "description": "Minimum memory in GB for GitLab"
        },
        "gitlab_min_cpu_cores": {
            "type": "integer",
            "minimum": 1,
            "description": "Minimum CPU cores for GitLab"
        },
        "gitlab_puma_workers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64,
            "description": "Puma web worker count"
        },
        "gitlab_sidekiq_concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "Sidekiq background job concurrency"
        },
        "gitlab_project_ci_timeout": {
            "type": "integer",
            "minimum": 600,
            "default": 9000,
            "description": "Maximum runtime in seconds for a GitLab CI/CD pipeline job (2.5 hours by default)"
        },
        "log_tail_lines_default": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 50,
            "description": "Lines returned per stage log when tail_lines is omitted"
        },
        "log_tail_lines_max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 10000,
            "description": "Largest tail_lines value accepted by the log query API"
        },
        "max_log_response_bytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 52428800,
            "default": 10485760,
            "description": "Maximum log bytes returned per stage by the log query API"
        },
        "log_ci_preview_lines": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 50,
            "description": "Execution-log lines previewed in the GitLab CI job console"
        },
        "log_query_rate_limit": {
            "type": "integer",
            "minimum": 1,
            "default": 60,
            "description": "Log query requests allowed per client per minute"
        },
        "log_query_max_concurrent": {
            "type": "integer",
            "minimum": 1,
            "default": 5,
            "description": "Concurrent log query requests served across all clients"
        },
        "cadence": {
            "type": "object",
            "description": "Cadence polling configuration for periodic package sync",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Enable or disable cadence polling for periodic package sync"
                },
                "interval_days": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 7,
                    "description": "Cadence polling interval in days (minimum 1 day)"
                },
                "sync_timeout_seconds": {
                    "type": "integer",
                    "minimum": 60,
                    "description": "Timeout for repo sync playbook execution"
                },
                "sync_poll_interval_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 300,
                    "description": "Poll interval while waiting for sync result"
                }
            },

            "additionalProperties": false
        },
        "retention": {
            "type": "object",
            "description": "Automatic image cleanup (age-based retention) configuration",
            "properties": {
                "auto_cleanup_enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable or disable automatic image cleanup"
                },
                "retention_age_days": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 90,
                    "description": "Age in days after which a never-deployed image group is cleaned up"
                },
                "min_keep_count": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 5,
                    "description": "Minimum number of image groups kept per functional group"
                },
                "evaluation_interval_hours": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 24,
                    "description": "Interval between automatic cleanup cycles in hours (minimum 1 hour)"
                }
            },
            "additionalProperties": false
        },
        "redaction": {
            "type": "object",
            "description": "Operator additions to the redaction of secrets in execution logs",
            "properties": {
                "additional_secret_key_names": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,39}$"
                    },
                    "description": "Extra key names whose values are redacted in key = value lines"
                },
                "additional_secret_patterns": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9-]{1,40}$",
                                "description": "Unique rule id; must not reuse a baseline or built-in id"
                            },
                            "pattern": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 256,
                                "description": "Regular expression whose matches are redacted"
                            },
                            "description": {
                                "type": "string",
                                "maxLength": 200,
                                "description": "Human-readable description of the secret"
                            }
                        },
                        "required": ["id", "pattern"],
                        "additionalProperties": false
                    },
                    "description": "Extra Tier 1 patterns, always replaced with ***REDACTED***"
                }
            },
            "additionalProperties": false
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "enable_build_stream": {
                        "const": true
                    }
                },
                "required": ["enable_build_stream"]
            },
            "then": {
                "required": [
                    "build_stream_host_ip",
                    "build_stream_port",
                    "gitlab_mode"
                ],
                "properties": {
                    "build_stream_host_ip": {
                        "minLength": 1,
                        "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "enable_build_stream": {"const": true},
                    "gitlab_mode": {"const": "hosted"}
                },
                "required": ["enable_build_stream", "gitlab_mode"]
            },
            "then": {
                "required": ["gitlab_host"],
                "properties": {
                    "gitlab_host": {
                        "minLength": 1,
                        "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "enable_build_stream": {"const": true},
                    "gitlab_mode": {"const": "external"}
                },
                "required": ["enable_build_stream", "gitlab_mode"]
            },
            "then": {
                "required": ["gitlab_external_url", "gitlab_project_namespace"],
                "properties": {
                    "gitlab_external_url": {
                        "minLength": 1,
                        "pattern": "^https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$"
                    },
                    "gitlab_project_namespace": {
                        "minLength": 1,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*(/[A-Za-z0-9][A-Za-z0-9_.-]*)*$"
                    }
                }
            }
        }
    ],
    "additionalProperties": false
}
