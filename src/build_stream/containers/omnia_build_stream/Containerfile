# Containerfile for omnia_build_stream FastAPI service
# NOTE: Application code is NOT copied into the image. It is bind-mounted
# at runtime via Quadlet Volume directives (see build_stream.j2).

FROM cgr.dev/chainguard/wolfi-base@sha256:bc76fa39ddd1482dd56a761b3331e03ba8f0e093ebb525618a56d014b480da88

# Metadata - OCI Standard Labels
LABEL org.opencontainers.image.title="Omnia Build Stream API Server"
LABEL org.opencontainers.image.description="API server for Omnia Build Stream automation"
LABEL org.opencontainers.image.vendor="Dell Technologies"
LABEL org.opencontainers.image.base.name="cgr.dev/chainguard/wolfi-base"
LABEL omnia.component="build_stream"
LABEL omnia.type="api_service"

# Install runtime packages and apply all available security patches
# openssh: required by ansible-core for SSH connections to managed nodes
# apk upgrade: pulls latest patched versions of all base packages to fix:
#   CVE-2026-19931/18924/82209/80229/80230/80231/82208/13608 (curl >=8.22.0-r2)
#   CVE-2026-85091  (zlib >=1.3.3-r0)
#   CVE-2026-19499/77117/80489/8674/18374/89092/86805 (glibc >=2.44-r8)
#   CVE-2026-82049/15806/17084/19672/87910 (python-3.13 >=3.13.16)
#   CVE-2026-97689/97688 (py3.13-pip-base >=26.2.1-r2)
RUN apk update && apk upgrade --no-cache && apk add --no-cache \
    python3 \
    py3-pip \
    curl \
    ca-certificates-bundle \
    openssh \
    bash

# Install build-time dependencies (removed after compilation in a later step)
RUN apk add --no-cache --virtual .build-deps build-base python3-dev

# -------------------------------------------------------
# FIX: Upgraded uv from 0.11.15 to 0.12.2 to fix:
#   GHSA-2mjx-qc3c-rqvc (rustls >=0.23.45)
#   GHSA-c8m5-c952-6cm4 (rustls >=0.23.46)
#   GHSA-3g6h-r5qx-f6hq / GHSA-4w2j-m93h-cj5j (quinn-proto >=0.11.15)
#   RUSTSEC-2026-0195 / RUSTSEC-2026-0194 (quick-xml >=0.41.0)
#   CVE-2026-25800 (quinn-proto >=0.11.15)
#   + GHSA-3cv2-h65g-fgmm, GHSA-4gg8-gxpx-9rph (from prior 0.11.15)
#
# NOTE: CVE-2023-49092 (rsa crate) has no upstream fix.
# -------------------------------------------------------
COPY --from=ghcr.io/astral-sh/uv:0.12.2@sha256:069a51314a7bb6031777a9273205fe1b0b19e914ef418207d1338b268df641dd /uv /uvx /usr/local/bin/

# -------------------------------------------------------
# KNOWN: CVE-2025-47273 (High 7.7) & CVE-2026-59890 (Medium 6.1)
#   The wolfi py3-pip apk package vendors setuptools 70.3.0 internally.
#   setuptools>=84.0.0 is installed as a top-level package (via pyproject.toml),
#   which takes precedence at runtime. The vendored 70.3.0 copy inside pip is
#   not used. This will be fully resolved once the wolfi upstream releases an
#   updated py3-pip package with a patched vendored setuptools.
# -------------------------------------------------------

# =======================================================
ENV UV_PYTHON_DOWNLOADS=never
ENV UV_SYSTEM_PYTHON=1

# =======================================================
# DEPENDENCIES: Install from committed lock file (uv.lock ensures reproducible builds)
COPY pyproject.toml uv.lock ./
# Every package (including s3cmd) is installed from uv.lock with its hash verified.
RUN uv export --locked --no-emit-project -o requirements.txt && \
    uv pip install --system --require-hashes -r requirements.txt

# Optionally install dev dependencies
ARG BUILD_ENV=production
RUN if [ "$BUILD_ENV" = "development" ]; then \
      uv export --locked --no-emit-project --extra dev -o requirements-dev.txt && \
      uv pip install --system --require-hashes -r requirements-dev.txt; \
    fi

# Remove build-time dependencies to reduce image size and attack surface
RUN apk del .build-deps

# ── S3 Configuration Setup ──────────────────────────────────
COPY init_s3cfg.sh /usr/local/bin/init_s3cfg.sh
RUN chmod +x /usr/local/bin/init_s3cfg.sh

# -------------------------------------------------------
# APP SOURCE: Code is NOT embedded in the image.
# It is deployed to NFS via copy-input.sh (called by
# omnia.sh --setup-venv) and mounted into the container
# at runtime via the NFS volume mount.
# -------------------------------------------------------

# Create app and SSL directories
ENV APP_DIR=/opt/omnia/build_stream
WORKDIR ${APP_DIR}
RUN mkdir -p /etc/ssl/omnia

# ── Runtime environment ─────────────────────────────────────
ENV SSL_KEYFILE=/etc/ssl/omnia/bs_key.pem
ENV SSL_CERTFILE=/etc/ssl/omnia/bs_cert.pem

# MinIO S3 configuration — do NOT set defaults here; pass credentials
# exclusively at runtime via Quadlet Environment directives or --env flags.
# ENV values are visible in image metadata (podman inspect / docker history).

EXPOSE 8443

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -fsk https://localhost:${PORT:-8443}/health || exit 1

# ── Entrypoint ───────────────────────────────────────────────
ENTRYPOINT ["/bin/bash", "-c", "/usr/local/bin/init_s3cfg.sh || echo 'WARNING: S3 config init failed' >&2; exec python3 -Xfrozen_modules=off -m uvicorn main:app --host \"${HOST:?HOST env required}\" --port \"${PORT:?PORT env required}\" --ssl-keyfile \"${SSL_KEYFILE}\" --ssl-certfile \"${SSL_CERTFILE}\""]
