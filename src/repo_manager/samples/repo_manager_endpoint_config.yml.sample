# -----------------------------------------------------------------------------
# PULP SERVER ENDPOINT
# -----------------------------------------------------------------------------
# Pulp server port
pulp_server_port: 2225

# HTTPS is mandatory. Certificate paths are derived automatically from
# REPO_MANAGER_DATA_PATH or OMNIA_DATA_PATH and must not be configured here.
