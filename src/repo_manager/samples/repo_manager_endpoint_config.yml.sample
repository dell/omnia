# =============================================================================
# REPO MANAGER ENDPOINT CONFIGURATION SAMPLE
# =============================================================================
# This is a sample endpoint configuration file for Pulp server.
# Copy this file to your input directory and modify according to your needs.
# =============================================================================

# -----------------------------------------------------------------------------
# PULP SERVER ENDPOINT
# -----------------------------------------------------------------------------
# Pulp server port
pulp_server_port: 2225

# Pulp protocol: "https"
pulp_protocol: "https"

# Enable HTTPS
pulp_https_enabled: true

# -----------------------------------------------------------------------------
# SSL CERTIFICATES
# -----------------------------------------------------------------------------
# These paths are under OMNIA_DATA_PATH/repo_manager/pulp_config/
# Use OMNIA_DATA_PATH environment variable for portability.
# Modify only if using a custom OMNIA_DATA_PATH or certificate location.

ssl_certificates:
  server_crt: "{{ lookup('env', 'OMNIA_DATA_PATH') | default('/opt/omnia') }}/repo_manager/pulp_config/settings/certs/pulp_webserver.crt"
  server_key: "{{ lookup('env', 'OMNIA_DATA_PATH') | default('/opt/omnia') }}/repo_manager/pulp_config/settings/certs/pulp_webserver.key"
  certs_dir: "{{ lookup('env', 'OMNIA_DATA_PATH') | default('/opt/omnia') }}/repo_manager/pulp_config/settings/certs"