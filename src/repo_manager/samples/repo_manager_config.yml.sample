# =============================================================================
# REPO MANAGER CONFIGURATION SAMPLE
# =============================================================================
# This is a sample configuration file for repo_manager.
# Copy this file to your input directory and modify according to your needs.
# =============================================================================

# -----------------------------------------------------------------------------
# BASIC CONFIGURATION
# -----------------------------------------------------------------------------
cluster_os_type: "rhel"
cluster_os_version: "10.0"

# -----------------------------------------------------------------------------
# PULP SERVER CONFIGURATION
# -----------------------------------------------------------------------------
pulp_protocol: "https"

# -----------------------------------------------------------------------------
# REPOSITORY CONFIGURATION
# -----------------------------------------------------------------------------
repositories:
  x86_64_rhel_10.0_epel:
    name: "x86_64_rhel_10.0_epel"
    baseurl: "https://download.fedoraproject.org/pub/epel/10/Everything/x86_64/"
    enabled: true
    gpgcheck: false

  x86_64_rhel_10.0_appstream:
    name: "x86_64_rhel_10.0_appstream"
    baseurl: "https://cdn.redhat.com/content/dist/rhel10/10/x86_64/appstream/os"
    enabled: true
    gpgcheck: true

# -----------------------------------------------------------------------------
# CUSTOM REPOSITORY URLS (OPTIONAL)
# -----------------------------------------------------------------------------
# Add custom repository URLs for specific architectures
# user_repo_url_x86_64:
#   - name: "custom_repo_x86_64"
#     baseurl: "https://your-custom-repo.com/x86_64/"
#     enabled: true
#     gpgcheck: false

# user_repo_url_aarch64:
#   - name: "custom_repo_aarch64"
#     baseurl: "https://your-custom-repo.com/aarch64/"
#     enabled: true
#     gpgcheck: false

# -----------------------------------------------------------------------------
# ADDITIONAL REPOSITORIES (OPTIONAL)
# -----------------------------------------------------------------------------
# additional_repos_x86_64:
#   - name: "additional_repo_x86_64"
#     baseurl: "https://additional-repo.com/x86_64/"
#     enabled: true
#     gpgcheck: false

# additional_repos_aarch64:
#   - name: "additional_repo_aarch64"
#     baseurl: "https://additional-repo.com/aarch64/"
#     enabled: true
#     gpgcheck: false