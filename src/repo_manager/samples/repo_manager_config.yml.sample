---
# =============================================================================
# SAMPLE: repo_manager_config.yml -- Repo Manager input
# =============================================================================
#
# The catalog selects the OS versions and architectures. Define repository
# settings only for contexts referenced by that catalog. Empty BaseOS and
# AppStream entries use the host's RHEL subscription; provide URLs when the
# host is not entitled.
# =============================================================================

repo_config: "partial"
caching_policy: true

# Public registries do not require entries. Add only private registries or
# public registries that require custom authentication or TLS configuration.
registries: null

repositories:
  "10.0":
    x86_64:
      baseos: {}
      appstream: {}
      codeready-builder: {}
      additional_repos:
        monitoring:
          url: "https://packages.example.com/rhel/10.0/x86_64/"
          gpgkey: "https://packages.example.com/keys/RPM-GPG-KEY-example"
          policy: "partial"
          caching: true
          priority: 99

  "10.2":
    x86_64:
      baseos: {}
      appstream: {}
      codeready-builder: {}
      additional_repos:
        monitoring:
          url: "https://packages.example.com/rhel/10.2/x86_64/"
          gpgkey: "https://packages.example.com/keys/RPM-GPG-KEY-example"
          policy: "partial"
          caching: true
          priority: 99
