---

# Repo Manager credentials
# NOTE: This file may be encrypted by ansible-vault. The vault key file
#       (.repo_manager_config_credentials_key) must be preserved to decrypt.

# Pulp admin credentials for Pulp container access
# Required for setting up and managing the Pulp repository server.
# The playbook will prompt if these are left empty.
pulp_username: "{{ pulp_username | default('admin') }}"
pulp_password: "{{ pulp_password | default('CHANGE_THIS_PASSWORD') }}"

# Docker Hub credentials for accessing container registries
# Leave empty if Docker Hub authentication is not required.
docker_username: "{{ docker_username | default('') | string | trim }}"
docker_password: "{{ docker_password | default('') | string | trim }}"

# User registry credentials for private container registries
# Each registry can have different authentication requirements
{% if registry_credentials | default([]) | length > 0 %}
registry_credentials:
{% for reg in registry_credentials %}
  {{ reg.registry_name }}:
    auth_type: "{{ reg.auth_type | default('basic') }}"
    {% if reg.auth_type != 'none' %}
    username: "{{ lookup('vars', reg.username_field, default('')) }}"
    {% if reg.password_field | default('') | length > 0 %}
    password: "{{ lookup('vars', reg.password_field, default('')) }}"
    {% else %}
    password: ""
    {% endif %}
    vault_path: "{{ reg.vault_path | default('') }}"
    tls_ca_path: "{{ lookup('vars', reg.tls_ca_path, default('')) }}"
    tls_cert_path: "{{ lookup('vars', reg.tls_cert_path, default('')) }}"
    tls_key_path: "{{ lookup('vars', reg.tls_key_path, default('')) }}"
    insecure_skip_verify: "{{ lookup('vars', reg.insecure_skip_verify, default('false')) }}"
    {% else %}
    auth_type: "none"
    username: ""
    password: ""
    vault_path: ""
    tls_ca_path: "{{ lookup('vars', reg.tls_ca_path, default('')) }}"
    tls_cert_path: "{{ lookup('vars', reg.tls_cert_path, default('')) }}"
    tls_key_path: "{{ lookup('vars', reg.tls_key_path, default('')) }}"
    insecure_skip_verify: "{{ lookup('vars', reg.insecure_skip_verify, default('false')) }}"
    {% endif %}
{% endfor %}
{% else %}
registry_credentials: {}
{% endif %}
