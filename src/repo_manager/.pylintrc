# =============================================================================
# Pylint Configuration for Omnia repo_manager
# =============================================================================
# This configuration defines the linting rules for Python code in repo_manager.
#
# Last updated: 2026-07-23
# =============================================================================

[MAIN]
# Specify a score threshold under which the program will exit with error.
fail-under=8.0

# Files or directories to be skipped.
ignore=__pycache__,output,input_test,.data

# Use multiple processes to speed up Pylint.
jobs=4

# Pickle collected data for later comparisons.
persistent=yes

[MESSAGES CONTROL]
# Disable the following checks:
#
# import-error, no-name-in-module:
#   False positives for ansible.module_utils imports which work at runtime
#   but pylint cannot resolve statically.
#
# broad-exception-caught:
#   Intentional in Ansible modules to ensure graceful failure reporting.
#   All exceptions are logged before being handled.
#
# protected-access:
#   Used intentionally for ssl._create_unverified_context() for self-signed
#   certificates in internal Pulp communication.
#
# too-many-arguments, too-many-locals, too-many-branches, too-many-statements:
#   Some functions are complex by necessity. Refactoring would reduce readability.
#
# duplicate-code:
#   Some code patterns are intentionally similar across modules for consistency.
#
disable=
    import-error,
    no-name-in-module,
    broad-exception-caught,
    protected-access,
    too-many-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-instance-attributes,
    too-few-public-methods,
    duplicate-code,
    fixme,
    line-too-long

[FORMAT]
# Maximum number of characters on a single line.
max-line-length=160

# Maximum number of lines in a module.
max-module-lines=2000

# String used as indentation unit.
indent-string='    '

# Number of spaces of indent required inside a hanging or continued line.
indent-after-paren=4

[BASIC]
# Good variable names which should always be accepted.
good-names=i,j,k,f,e,ex,fd,fp,id,ip,ok,os,re,db,df,_

# Regular expression matching correct argument names.
argument-rgx=[a-z_][a-z0-9_]{1,50}$

# Regular expression matching correct variable names.
variable-rgx=[a-z_][a-z0-9_]{1,50}$

# Regular expression matching correct function names.
function-rgx=[a-z_][a-z0-9_]{2,50}$

# Regular expression matching correct method names.
method-rgx=[a-z_][a-z0-9_]{2,50}$

# Regular expression matching correct constant names.
const-rgx=(([A-Z_][A-Z0-9_]*)|(__.*__)|([a-z_][a-z0-9_]*))$

[DESIGN]
# Maximum number of arguments for function / method.
max-args=15

# Maximum number of locals for function / method body.
max-locals=25

# Maximum number of return / yield for function / method body.
max-returns=10

# Maximum number of branch for function / method body.
max-branches=20

# Maximum number of statements in function / method body.
max-statements=100

# Maximum number of attributes for a class.
max-attributes=20

# Maximum number of public methods for a class.
max-public-methods=30

[SIMILARITIES]
# Minimum lines number of a similarity.
min-similarity-lines=10

# Ignore comments when computing similarities.
ignore-comments=yes

# Ignore docstrings when computing similarities.
ignore-docstrings=yes

# Ignore imports when computing similarities.
ignore-imports=yes

[TYPECHECK]
# List of module names for which member attributes should not be checked.
ignored-modules=ansible.module_utils

# List of class names for which member attributes should not be checked.
ignored-classes=AnsibleModule

[LOGGING]
# The type of string formatting that logging methods do.
logging-format-style=new
