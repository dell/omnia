{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Schema for repo_manager_config.yml (catalog-based approach)",
  "properties": {
    "catalog_config": {
      "type": "object",
      "description": "Catalog configuration pointing to the catalog JSON file",
      "properties": {
        "catalog": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the catalog JSON file"
        }
      },
      "required": ["catalog"],
      "additionalProperties": false
    },
    "repo_config": {
      "type": "string",
      "enum": ["always", "partial"],
      "description": "Global repository sync policy"
    },
    "caching_policy": {
      "type": "boolean",
      "description": "Global caching policy that controls Pulp download behavior",
      "default": true
    },
    "registries": {
      "type": ["object", "null"],
      "description": "Container registry configurations keyed by registry name",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "base_url": {
            "type": "string",
            "pattern": "^https?:\\/\\/.+"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "auth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["none", "basic"]
              },
              "credentials": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "properties": {
                  "vault_path": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "required": ["type"],
            "allOf": [
              {
                "if": {
                  "properties": {"type": {"const": "basic"}}
                },
                "then": {
                  "required": ["credentials"],
                  "properties": {
                    "credentials": {
                      "type": "object",
                      "required": ["vault_path"]
                    }
                  }
                }
              }
            ]
          },
          "tls": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "ca_path": {
                "type": ["string", "null"]
              },
              "client_cert_path": {
                "type": ["string", "null"]
              },
              "client_key_path": {
                "type": ["string", "null"]
              },
              "insecure": {
                "type": "boolean"
              }
            }
          }
        },
        "required": ["base_url", "port", "auth"]
      }
    },
    "repositories": {
      "type": "object",
      "description": "RPM repository configurations: version -> arch -> repo_name -> config",
      "additionalProperties": {
        "type": "object",
        "description": "Architecture-keyed repository definitions for a specific OS version",
        "properties": {
          "x86_64": {
            "$ref": "#/definitions/arch_repos"
          },
          "aarch64": {
            "$ref": "#/definitions/arch_repos"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["repo_config", "repositories"],
  "additionalProperties": false,
  "definitions": {
    "repo_entry": {
      "type": ["object", "null"],
      "description": "Single repository entry with optional URL, GPG key, and SSL settings",
      "properties": {
        "url": {
          "type": ["string", "null"],
          "description": "Repository URL (leave empty for RHEL subscription repos)"
        },
        "gpgkey": {
          "type": ["string", "null"],
          "description": "GPG key URL for package verification"
        },
        "policy": {
          "type": "string",
          "enum": ["always", "partial", "never"],
          "description": "Sync policy override for this repo"
        },
        "caching": {
          "type": "boolean",
          "description": "Enable local caching (default: true)"
        },
        "sslcacert": {
          "type": ["string", "null"],
          "description": "Path to SSL CA certificate"
        },
        "sslclientkey": {
          "type": ["string", "null"],
          "description": "Path to SSL client key (mTLS)"
        },
        "sslclientcert": {
          "type": ["string", "null"],
          "description": "Path to SSL client certificate (mTLS)"
        },
        "priority": {
          "type": "integer",
          "description": "Repository priority for yum/dnf",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "additional_repos_entry": {
      "type": ["object", "null"],
      "description": "Additional repositories section (map of repo_name -> repo config)",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/repo_entry"
      }
    },
    "arch_repos": {
      "type": "object",
      "description": "Repository definitions for a specific architecture",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]+$"
      },
      "properties": {
        "additional_repos": {
          "$ref": "#/definitions/additional_repos_entry"
        },
        "user_repos": {
          "type": ["object", "null"],
          "description": "User custom repositories",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/repo_entry"
          }
        }
      },
      "additionalProperties": {
        "$ref": "#/definitions/repo_entry"
      }
    }
  }
}
