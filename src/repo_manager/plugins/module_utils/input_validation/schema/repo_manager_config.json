{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Schema for repo_manager_config.yml (catalog-based approach)",
  "properties": {
    "repo_config": {
      "type": "string",
      "enum": ["always", "partial"],
      "description": "Global repository sync policy"
    },
    "registries": {
      "type": ["object", "null"],
      "description": "Container registry configurations keyed by registry name",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "BaseURL": {
            "type": "string",
            "pattern": "^https?:\\/\\/.+"
          },
          "Port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "Auth": {
            "type": ["object", "null"],
            "properties": {
              "Type": {
                "type": "string",
                "enum": ["none", "basic", "token"]
              },
              "Credentials": {
                "type": ["object", "null"],
                "properties": {
                  "VaultPath": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "TLS": {
            "type": ["object", "null"],
            "properties": {
              "CAPath": {
                "type": ["string", "null"]
              },
              "ClientCertPath": {
                "type": ["string", "null"]
              },
              "ClientKeyPath": {
                "type": ["string", "null"]
              },
              "Insecure": {
                "type": "boolean"
              }
            }
          },
          "Mirror": {
            "type": ["object", "null"],
            "properties": {
              "PulpURL": {
                "type": "string"
              },
              "PullThrough": {
                "type": "boolean"
              },
              "Prefix": {
                "type": "string"
              }
            }
          }
        },
        "required": ["BaseURL", "Port"]
      }
    },
    "repositories": {
      "type": "object",
      "description": "RPM repository configurations: version -> arch -> repo_name -> config",
      "additionalProperties": {
        "type": "object",
        "description": "Architecture-keyed repository definitions for a specific OS version",
        "properties": {
          "x86_64": {
            "$ref": "#/definitions/arch_repos"
          },
          "aarch64": {
            "$ref": "#/definitions/arch_repos"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["repo_config", "repositories"],
  "additionalProperties": false,
  "definitions": {
    "repo_entry": {
      "type": ["object", "null"],
      "description": "Single repository entry with optional URL, GPG key, and SSL settings",
      "properties": {
        "url": {
          "type": ["string", "null"],
          "description": "Repository URL (leave empty for RHEL subscription repos)"
        },
        "gpgkey": {
          "type": ["string", "null"],
          "description": "GPG key URL for package verification"
        },
        "policy": {
          "type": "string",
          "enum": ["always", "partial", "never"],
          "description": "Sync policy override for this repo"
        },
        "caching": {
          "type": "boolean",
          "description": "Enable local caching (default: true)"
        },
        "sslcacert": {
          "type": ["string", "null"],
          "description": "Path to SSL CA certificate"
        },
        "sslclientkey": {
          "type": ["string", "null"],
          "description": "Path to SSL client key (mTLS)"
        },
        "sslclientcert": {
          "type": ["string", "null"],
          "description": "Path to SSL client certificate (mTLS)"
        }
      },
      "additionalProperties": false
    },
    "additional_repos_entry": {
      "type": ["object", "null"],
      "description": "Additional repositories section (map of repo_name -> repo config)",
      "additionalProperties": {
        "$ref": "#/definitions/repo_entry"
      }
    },
    "arch_repos": {
      "type": "object",
      "description": "Repository definitions for a specific architecture",
      "properties": {
        "additional_repos": {
          "$ref": "#/definitions/additional_repos_entry"
        }
      },
      "additionalProperties": {
        "$ref": "#/definitions/repo_entry"
      }
    }
  }
}
