{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "pulp_server_ip": {
      "type": "string",
      "format": "ipv4",
      "description": "Pulp server IP address (also used for OIM SSH connection)."
    },
    "pulp_server_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 2225,
      "description": "Pulp server port."
    }
  },
  "required": ["pulp_server_port"],
  "additionalProperties": false
}
