<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Catalog Changelog: {{ current_name }} &rarr; {{ future_name }}</title>
<style>
  :root {
    --blocking: #b42318;
    --warning: #b54708;
    --added: #067647;
    --removed: #b42318;
    --changed: #175cd3;
    --border: #e5e7eb;
    --bg-muted: #f8fafc;
  }
  body {
    font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: #1f2937;
    max-width: 960px;
    margin: 2rem auto;
    padding: 0 1.5rem;
    line-height: 1.5;
  }
  h1 { font-size: 1.5rem; border-bottom: 2px solid var(--border); padding-bottom: 0.5rem; }
  h2 { font-size: 1.15rem; margin-top: 2rem; }
  .subtitle { color: #6b7280; font-size: 0.9rem; margin-top: -0.5rem; }
  table { width: 100%; border-collapse: collapse; margin: 0.75rem 0 1.5rem; font-size: 0.9rem; }
  th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid var(--border); }
  th { background: var(--bg-muted); font-weight: 600; }
  .badge {
    display: inline-block; padding: 0.1rem 0.5rem; border-radius: 999px;
    font-size: 0.75rem; font-weight: 600; color: white;
  }
  .badge.added { background: var(--added); }
  .badge.removed { background: var(--removed); }
  .badge.changed { background: var(--changed); }
  .badge.blocking { background: var(--blocking); }
  .badge.warning { background: var(--warning); }
  .empty { color: #6b7280; font-style: italic; }
  .warning-card {
    border: 1px solid var(--border); border-left: 4px solid var(--warning);
    border-radius: 4px; padding: 0.75rem 1rem; margin-bottom: 0.75rem; background: var(--bg-muted);
  }
  .warning-card.blocking { border-left-color: var(--blocking); }
  .warning-card .constraint-id { font-weight: 700; font-family: monospace; }
  .summary-counts { color: #374151; font-size: 0.95rem; }
  ul.notes { margin: 0.25rem 0 1.5rem; padding-left: 1.25rem; }
</style>
</head>
<body>

<h1>Catalog Changelog: {{ current_name }} &rarr; {{ future_name }}</h1>
<p class="subtitle">Schema version: {{ schema_version.current }} &rarr; {{ schema_version.future }}</p>

<h2>Compatibility / Dependency Warnings</h2>
{% if warnings %}
  {% for warning in warnings %}
  <div class="warning-card {{ warning.severity }}">
    <span class="badge {{ warning.severity }}">{{ warning.severity | upper }}</span>
    <span class="constraint-id">{{ warning.constraint_id }}</span>
    <p>{{ warning.message }}</p>
  </div>
  {% endfor %}
{% else %}
  <p class="empty">None detected.</p>
{% endif %}

<h2>Packages</h2>
<p class="summary-counts">
  {{ summary.packages.added | length }} added,
  {{ summary.packages.removed | length }} removed,
  {{ summary.packages.changed | length }} changed
</p>
{% if summary.packages.added or summary.packages.removed or summary.packages.changed %}
<table>
  <thead><tr><th>Change</th><th>Package</th><th>Before</th><th>After</th></tr></thead>
  <tbody>
    {% for item in summary.packages.added %}
    <tr><td><span class="badge added">added</span></td><td>{{ item.key }}</td><td>&mdash;</td>
      <td>{{ package_label(item.value) }}</td></tr>
    {% endfor %}
    {% for item in summary.packages.removed %}
    <tr><td><span class="badge removed">removed</span></td><td>{{ item.key }}</td>
      <td>{{ package_label(item.value) }}</td><td>&mdash;</td></tr>
    {% endfor %}
    {% for item in summary.packages.changed %}
    <tr><td><span class="badge changed">changed</span></td><td>{{ item.key }}</td>
      <td>{{ package_label(item.old) }}</td><td>{{ package_label(item.new) }}</td></tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p class="empty">No package changes.</p>
{% endif %}

<h2>Groups</h2>
<p class="summary-counts">
  {{ summary.groups.added | length }} added,
  {{ summary.groups.removed | length }} removed,
  {{ summary.groups.changed | length }} changed
</p>
{% if summary.groups.added or summary.groups.removed or summary.groups.changed %}
<table>
  <thead><tr><th>Change</th><th>Group</th></tr></thead>
  <tbody>
    {% for item in summary.groups.added %}
    <tr><td><span class="badge added">added</span></td><td>{{ item.key }}</td></tr>
    {% endfor %}
    {% for item in summary.groups.removed %}
    <tr><td><span class="badge removed">removed</span></td><td>{{ item.key }}</td></tr>
    {% endfor %}
    {% for item in summary.groups.changed %}
    <tr><td><span class="badge changed">changed</span></td><td>{{ item.key }}</td></tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p class="empty">No group changes.</p>
{% endif %}

<h2>Functional Layers</h2>
<p class="summary-counts">
  {{ summary.functionallayer.added | length }} added,
  {{ summary.functionallayer.removed | length }} removed,
  {{ summary.functionallayer.changed | length }} changed
</p>
{% if summary.functionallayer.added or summary.functionallayer.removed or summary.functionallayer.changed %}
<table>
  <thead><tr><th>Change</th><th>Functional Layer</th></tr></thead>
  <tbody>
    {% for item in summary.functionallayer.added %}
    <tr><td><span class="badge added">added</span></td><td>{{ item.key }}</td></tr>
    {% endfor %}
    {% for item in summary.functionallayer.removed %}
    <tr><td><span class="badge removed">removed</span></td><td>{{ item.key }}</td></tr>
    {% endfor %}
    {% for item in summary.functionallayer.changed %}
    <tr><td><span class="badge changed">changed</span></td><td>{{ item.key }}</td></tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p class="empty">No functional-layer changes.</p>
{% endif %}

<h2>Base OS, Architecture, and Catalog Metadata Impact</h2>
{% if base_os_notes or architecture_notes or summary.catalog_fields %}
<ul class="notes">
  {% for note in base_os_notes %}<li>{{ note }}</li>{% endfor %}
  {% for note in architecture_notes %}<li>{{ note }}</li>{% endfor %}
  {% for item in summary.catalog_fields %}
  <li>{{ item.field }}: {{ item.old }} &rarr; {{ item.new }}</li>
  {% endfor %}
</ul>
{% else %}
<p class="empty">No base OS, architecture, or catalog-metadata changes.</p>
{% endif %}

</body>
</html>
