# UFM Telemetry Credentials Secret
# Generated by enable_ufm role - do not edit manually
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ ufm_credentials_secret_name }}
  namespace: {{ telemetry_namespace }}
  labels:
    app: ufm-telemetry
    app.kubernetes.io/managed-by: omnia
type: Opaque
stringData:
{% if _ufm_detailed_config.auth_mode | default('basic') == 'basic' %}
  ufm_username: "{{ hostvars['localhost']['ufm_username'] | default('') }}"
  ufm_password: "{{ hostvars['localhost']['ufm_password'] | default('') }}"
{% endif %}
  ufm_endpoint: "{{ _ufm_detailed_config.ufm_endpoint }}"
  ufm_metrics_port: "{{ _ufm_detailed_config.ufm_metrics_port | default(9001) }}"
  tls_mode: "{{ _ufm_detailed_config.tls_mode | default('self_signed') }}"
  auth_mode: "{{ _ufm_detailed_config.auth_mode | default('basic') }}"
{% if _ufm_detailed_config.tls_mode | default('self_signed') == 'ca_signed' and ufm_ca_cert_content is defined %}
  ca.crt: |
{{ ufm_ca_cert_content | indent(4, True) }}
{% endif %}
