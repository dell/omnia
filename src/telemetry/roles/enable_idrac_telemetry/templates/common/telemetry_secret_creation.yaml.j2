apiVersion: v1
kind: Secret
metadata:
  name: "{{ mysqldb_secrets_name }}"
  namespace: "{{ telemetry_namespace }}"
type: Opaque
data:
  mysqldb_user: "{{ telemetry_credentials.mysqldb_user | b64encode }}"
  mysqldb_password: "{{ telemetry_credentials.mysqldb_password | b64encode }}"
  mysqldb_root_password: "{{ telemetry_credentials.mysqldb_root_password | b64encode }}"

{% if kafka_support %}
---
apiVersion: v1
kind: Secret
metadata:
  name: "{{ kafka.cluster_id }}"
  namespace: "{{ telemetry_namespace }}"
type: Opaque
stringData:
  cluster-id: "{{ cluster_id.stdout }}"
{% endif %}
