# =============================================================================
# VLAgent Syslog Source Configuration
# =============================================================================
# Provides per-source stream labels for syslog ingested by VLAgent.
# VLAgent receives syslog on TCP/UDP:514 from enabled log sources.
#
# Syslog listeners are configured via extraArgs in the VLAgent CR
# (victorialogs-operator-vlagent.yaml). This ConfigMap documents the
# expected syslog sources and provides labels for future stream processors.
#
# Active log sources:
{% if telemetry_config.telemetry_sources.powerscale.logs_enabled | default(false) %}
#   - PowerScale → syslog TCP/UDP:514 → VLAgent
{% endif %}
{% if telemetry_config.telemetry_bridges.vector_ome.logs_enabled | default(false) %}
#   - OME → Vector bridge → syslog TCP:514 → VLAgent
{% endif %}
# =============================================================================
apiVersion: v1
kind: ConfigMap
metadata:
  name: vlagent-config
  namespace: {{ telemetry_namespace }}
  labels:
    app: vlagent
    component: victorialogs
    app.kubernetes.io/managed-by: omnia
data:
  # Syslog sources expected to route logs to VLAgent LoadBalancer IP:514
  # Format: <source_name>: "<stream_label>"
  sources: |
{% if telemetry_config.telemetry_sources.powerscale.logs_enabled | default(false) %}
    powerscale: "powerscale-syslog"
{% endif %}
{% if telemetry_config.telemetry_bridges.vector_ome.logs_enabled | default(false) %}
    ome: "ome-syslog"
{% endif %}
{% if not (telemetry_config.telemetry_sources.powerscale.logs_enabled | default(false)) and not (telemetry_config.telemetry_bridges.vector_ome.logs_enabled | default(false)) %}
    # No log sources enabled — VLAgent deployed for future use
    placeholder: "no-sources-enabled"
{% endif %}
