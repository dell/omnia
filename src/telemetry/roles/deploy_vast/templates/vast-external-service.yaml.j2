# VAST External Service (Endpoints + headless Service)
# Routes vmagent scrape traffic to external VAST cluster
# Generated by deploy_vast role - do not edit manually
---
apiVersion: v1
kind: Endpoints
metadata:
  name: vast-telemetry-external
  namespace: {{ telemetry_namespace }}
  labels:
    app: vast-telemetry
    app.kubernetes.io/managed-by: omnia
subsets:
  - addresses:
      - ip: "{{ _vast_detailed_config.vast_endpoint }}"
    ports:
      - port: {{ _vast_detailed_config.vast_metrics_port | default(443) }}
        name: metrics
        protocol: TCP
---
apiVersion: v1
kind: Service
metadata:
  name: vast-telemetry-external
  namespace: {{ telemetry_namespace }}
  labels:
    app: vast-telemetry
    app.kubernetes.io/managed-by: omnia
spec:
  clusterIP: None
  ports:
    - port: {{ _vast_detailed_config.vast_metrics_port | default(443) }}
      targetPort: {{ _vast_detailed_config.vast_metrics_port | default(443) }}
      name: metrics
      protocol: TCP
