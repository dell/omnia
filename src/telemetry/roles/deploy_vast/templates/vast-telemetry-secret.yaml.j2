# VAST Telemetry Credentials Secret
# Generated by deploy_vast role - do not edit manually
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ vast_credentials_secret_name }}
  namespace: {{ telemetry_namespace }}
  labels:
    app: vast-telemetry
    app.kubernetes.io/managed-by: omnia
type: Opaque
stringData:
{% if _vast_detailed_config.auth_mode | default('basic') == 'basic' %}
  vast_username: "{{ hostvars['localhost']['vast_username'] | default('') }}"
  vast_password: "{{ hostvars['localhost']['vast_password'] | default('') }}"
{% endif %}
  vast_endpoint: "{{ _vast_detailed_config.vast_endpoint }}"
  vast_metrics_port: "{{ _vast_detailed_config.vast_metrics_port | default(443) }}"
  metrics_path: "{{ _vast_detailed_config.metrics_path | default('/api/prometheusmetrics/all') }}"
  tls_mode: "{{ _vast_detailed_config.tls_mode | default('self_signed') }}"
  auth_mode: "{{ _vast_detailed_config.auth_mode | default('basic') }}"
{% if _vast_detailed_config.tls_mode | default('self_signed') == 'ca_signed' and vast_ca_cert_content is defined %}
  ca.crt: |
{{ vast_ca_cert_content | indent(4, True) }}
{% endif %}
