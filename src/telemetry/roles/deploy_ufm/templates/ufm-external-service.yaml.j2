# UFM External Service (Endpoints + headless Service)
# Routes vmagent scrape traffic to external UFM appliance
# Generated by deploy_ufm role - do not edit manually
---
apiVersion: v1
kind: Endpoints
metadata:
  name: ufm-telemetry-external
  namespace: {{ telemetry_namespace }}
  labels:
    app: ufm-telemetry
    app.kubernetes.io/managed-by: omnia
subsets:
  - addresses:
      - ip: "{{ _ufm_detailed_config.ufm_endpoint }}"
    ports:
      - port: {{ _ufm_detailed_config.ufm_metrics_port | default(9001) }}
        name: metrics
        protocol: TCP
---
apiVersion: v1
kind: Service
metadata:
  name: ufm-telemetry-external
  namespace: {{ telemetry_namespace }}
  labels:
    app: ufm-telemetry
    app.kubernetes.io/managed-by: omnia
spec:
  clusterIP: None
  ports:
    - port: {{ _ufm_detailed_config.ufm_metrics_port | default(9001) }}
      targetPort: {{ _ufm_detailed_config.ufm_metrics_port | default(9001) }}
      name: metrics
      protocol: TCP
