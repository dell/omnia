# OTEL Collector TLS - selfsigned cert-manager Issuer and Certificate
# Replaces the Issuer and Certificate from the Karavi chart's templates/cert-manager.yaml,
# which is removed during install. Applied by helm_install_karavi.yml.
apiVersion: cert-manager.io/v1
kind: Issuer
metadata:
  name: {{ ps_otel_issuer_name }}
  namespace: {{ csm_observability_namespace }}
spec:
  selfSigned: {}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ ps_otel_certificate_name }}
  namespace: {{ csm_observability_namespace }}
spec:
  secretName: {{ ps_otel_tls_secret_name }}
  duration: 2160h
  renewBefore: 360h
  subject:
    organizations:
      - dellemc
  isCA: false
  privateKey:
    algorithm: RSA
    encoding: PKCS1
    size: 2048
  usages:
    - server auth
    - client auth
  dnsNames:
    - otel-collector
    - otel-collector.{{ csm_observability_namespace }}.svc
    - otel-collector.{{ csm_observability_namespace }}.svc.cluster.local
  issuerRef:
    name: {{ ps_otel_issuer_name }}
    kind: Issuer
    group: cert-manager.io
