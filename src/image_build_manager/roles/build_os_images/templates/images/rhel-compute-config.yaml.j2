options:
  layer_type: base
  name: '{{ rhel_base_compute_image_name }}'
  publish_tags: '{{ rhel_tag }}'
  pkg_manager: dnf
  parent: '{{ registry_host }}:5000/{{ oim_node_name }}/{{ rhel_arch_base_image_name }}:{{ rhel_tag }}'
  registry_opts_pull:
    - '--tls-verify={{ registry_tls_verify | default(false) | lower }}'
  publish_s3: '{{ s3_endpoint }}'
  s3_prefix: '{{ group_name }}/{{ rhel_base_compute_image_name }}/'
  s3_bucket: 'boot-images'
  publish_registry: '{{ registry_host }}:5000/{{ oim_node_name }}'
  registry_opts_push:
    - '--tls-verify={{ registry_tls_verify | default(false) | lower }}'

{% set _ssl = '1' if (repo_ssl_verify | default(true) | bool) else '0' %}
repos:
{% for repo in rhel_arch_repos %}
{% if repo.base_url | length > 1 %}
  - alias: '{{ repo.name }}'
    url: '{{ repo.base_url }}'
    priority: '{{ repo.priority | default("99") }}'
    sslverify: '{{ _ssl }}'
    gpgcheck: '{{ _ssl }}'
{% endif %}
{% if repo.gpg | length > 1 %}
    gpg: '{{ repo.gpg }}'
{% endif %}
{% endfor %}

packages:
{% for pkg in compute_packages %}
  - {{ pkg }}
{% endfor %}

{% set _fg_base = functional_group | regex_replace('_rhel_[0-9]+_[0-9]+', '') %}
{% set command_var = _fg_base + '_compute_commands' %}
{% set commands_list = lookup('vars', command_var, default=[]) %}
cmds:
{% if commands_list | length > 0 %}
{% for cmd in commands_list %}
  - cmd: "{{ cmd }}"
{% endfor %}
{% else %}
  []
{% endif %}
