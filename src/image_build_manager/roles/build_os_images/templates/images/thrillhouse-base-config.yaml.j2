{% set _tag = _render_rhel_tag | default(rhel_tag) %}
{% set _repos = _render_arch_repos | default(rhel_arch_repos) %}
{% set _base_pkgs = _render_base_packages | default(base_image_packages) %}
meta:
  name: '{{ rhel_arch_base_image_name }}'
  tags:
    - '{{ _tag }}'
  from: scratch

layer:
  manager:
    name: dnf
    options:
      releasever: "{{ _tag }}"
  repos:
{% for repo in _repos %}
{% if repo.base_url is defined and repo.base_url | length > 1 %}
    - path: /etc/yum.repos.d/{{ repo.name }}.repo
      content: |
        [{{ repo.name }}]
        name={{ repo.name }}
        baseurl={{ repo.base_url }}
        gpgcheck=0
        sslverify={{ '0' if not (repo_ssl_verify | default(true) | bool) else '1' }}
{% if (repo_ssl_verify | default(true) | bool) and (repo_cert_path | default('') | length > 0) %}
        sslcacert={{ anchors_path }}
{% endif %}
        priority={{ repo.priority | default("99") }}
{% endif %}
{% endfor %}
{% if (repo_ssl_verify | default(true) | bool) and (repo_cert_path | default('') | length > 0) %}
  files:
    - path: {{ anchors_path }}
      src: {{ anchors_path }}
{% endif %}
  actions:
    install:
      groups:
        - Minimal Install
        - Development Tools
      packages:
{% for pkg in _base_pkgs %}
        - {{ pkg }}
{% endfor %}
{% if thrillhouse_base_image_commands | default([]) | length > 0 %}
    commands:
{% for cmd in thrillhouse_base_image_commands %}
      - script: |
          #!/bin/bash
          {{ cmd }}
{% endfor %}
{% endif %}

publish:
  - type: registry
    url: '{{ registry_host }}:5000/{{ oim_node_name }}'
    tls-verify: false
