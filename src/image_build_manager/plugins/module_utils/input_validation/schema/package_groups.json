{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "package_groups",
    "description": "Schema for package_groups.yml used by config-mode image builds.",
    "type": "object",
    "required": ["os", "os_version", "base_packages", "functional_groups"],
    "properties": {
        "os": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$"
        },
        "os_version": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9]+(?:\\.[0-9]+)*$"
        },
        "base_packages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S(?:.*\\S)?$"
            }
        },
        "functional_groups": {
            "type": "object",
            "minProperties": 1,
            "patternProperties": {
                "^[a-zA-Z0-9][a-zA-Z0-9_-]*_(?:x86_64|aarch64)$": {
                    "type": "object",
                    "required": ["packages"],
                    "properties": {
                        "packages": {
                            "type": "array",
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "^\\S(?:.*\\S)?$"
                            }
                        }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
