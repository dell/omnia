{
  "catalog": {
    "name": "omnia services catalog - rhel 10.0 (slurm-only test)",
    "version": "1.0",
    "identifier": "omnia-services-rhel-10-0-slurm-test",
    "description": "minimal test catalog containing only slurm control node and slurm node functional layers for x86_64. baseos and admin_debug groups include a representative subset of packages. use catalog_rhel.json for the full production catalog.",
