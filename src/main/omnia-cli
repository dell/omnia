# ─────────────────────────────────────────────────────────────────────────────
# Argument Parsing
# ─────────────────────────────────────────────────────────────────────────────
_domain_from_arg() {
    case "$1" in
        repo_manager|image_build_manager|orchestrator|discovery|telemetry|build_stream|utils)
            echo "$1"
            ;;
        *) echo "" ;;
    esac
}

# ─────────────────────────────────────────────────────────────────────────────
# Main Dispatch
# ─────────────────────────────────────────────────────────────────────────────
main() {
    load_env

    local command="${1:-help}"
    shift || true

    # Parse --project flag and positional args from remaining args
    local project_flag=""
    local project=""
    local log_limit=""
    local positional_args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --project|-p)
                project_flag="${2:-project_default}"
                shift 2 || { echo -e "${RED}--project requires a value${NC}"; exit 1; }
                ;;
            --limit|-l)
                log_limit="${2:-}"
                shift 2 || { echo -e "${RED}--limit requires a value${NC}"; exit 1; }
                ;;
            *)
                positional_args+=("$1")
                shift
                ;;
        esac
    done

    # --project flag takes priority over env var; positional args never override --project
    project="${project_flag:-${OMNIA_PROJECT_NAME:-project_default}}"

    # Validate project name (prevent path traversal)
    if [[ ! "$project" =~ ^[a-zA-Z0-9_][a-zA-Z0-9_.-]*$ ]]; then
        echo -e "${RED}Invalid project name: '${project}'${NC}" >&2
        echo -e "${DIM}Allowed: letters, digits, underscore, hyphen, dot${NC}" >&2
        exit 1
    fi

    # Validate log limit (must be a positive integer)
    if [ -n "$log_limit" ] && ! [[ "$log_limit" =~ ^[1-9][0-9]*$ ]]; then
        echo -e "${RED}Invalid --limit value: '${log_limit}'${NC}" >&2
        echo -e "${DIM}Must be a positive integer${NC}" >&2
        exit 1
    fi

    # Dispatch: edit/logs use first positional as domain; others ignore positional args
    case "$command" in
        status)
            cmd_status "$project" || true
            ;;
        check)
            cmd_check "$project"
            ;;
        repo_manager)
            cmd_repo_manager "$project"
            ;;
        image_build_manager)
            cmd_image_build_manager "$project"
            ;;
        edit)
            if [ "${positional_args[0]:-}" = "--help" ] || \
               [ "${positional_args[0]:-}" = "-h" ]; then
                show_edit_help
                return 0
            fi
            if [ "${#positional_args[@]}" -eq 0 ]; then
                echo -e "${RED}edit requires a domain argument${NC}"
                echo -e "Usage: omnia-cli edit <domain> [file] [--project <name>]"
                echo -e "Domains: repo_manager, image_build_manager, orchestrator, discovery, telemetry, build_stream, utils"
                exit 1
            fi
            local domain
            domain=$(_domain_from_arg "${positional_args[0]}")
            if [ -z "$domain" ]; then
                echo -e "${RED}Unknown domain: ${positional_args[0]}${NC}"
                exit 1
            fi
            if [ "${positional_args[1]:-}" = "--help" ] || \
               [ "${positional_args[1]:-}" = "-h" ]; then
                show_edit_help
                return 0
            fi
            cmd_edit "$domain" "$project" "${positional_args[1]:-}"
            ;;
        logs|log)
            if [ "${positional_args[0]:-}" = "--help" ] || \
               [ "${positional_args[0]:-}" = "-h" ]; then
                show_logs_help
                return 0
            fi
            if [ "${#positional_args[@]}" -eq 0 ]; then
                echo -e "${RED}logs requires a domain argument${NC}"
                echo -e "Usage: omnia-cli logs <domain> [--project <name>] [--limit <n>]"
                echo -e "Domains: repo_manager, image_build_manager, orchestrator, discovery, telemetry, build_stream, utils"
                exit 1
            fi
            local domain
            domain=$(_domain_from_arg "${positional_args[0]}")
            if [ -z "$domain" ]; then
                echo -e "${RED}Unknown domain: ${positional_args[0]}${NC}"
                exit 1
            fi
            if [ "${positional_args[1]:-}" = "--help" ] || \
               [ "${positional_args[1]:-}" = "-h" ]; then
                show_logs_help
                return 0
            fi
            cmd_logs "$domain" "$project" "$log_limit"
            ;;
        version|--version|-v)
            cmd_version
            ;;
        help|--help|-h)
            if [ "${#positional_args[@]}" -gt 0 ]; then
                local domain
                domain=$(_domain_from_arg "${positional_args[0]}")
                if [ -n "$domain" ]; then
                    show_domain_help "$domain"
                else
                    echo -e "${RED}Unknown domain: ${positional_args[0]}${NC}"
                    show_help
                fi
            else
                show_help
            fi
            ;;
        *)
            # Try as a domain name
            local domain
            domain=$(_domain_from_arg "$command")
            if [ -n "$domain" ]; then
                cmd_domain_status "$domain" "$project"
            else
                echo -e "${RED}Unknown command: ${command}${NC}"
                echo ""
                show_help
                exit 1
            fi
            ;;
    esac
}

main "$@"
