# ─────────────────────────────────────────────────────────────────────────────
# Argument Parsing
# ─────────────────────────────────────────────────────────────────────────────
_domain_from_arg() {
    case "$1" in
        repo-manager|repo_manager)   echo "repo_manager" ;;
        image-build|image_build|image-build-manager|image_build_manager) echo "image_build_manager" ;;
        orchestrator)                echo "orchestrator" ;;
        discovery)                   echo "discovery" ;;
        telemetry)                   echo "telemetry" ;;
        build-stream|build_stream)   echo "build_stream" ;;
        *)                           echo "" ;;
    esac
}

# ─────────────────────────────────────────────────────────────────────────────
# Main Dispatch
# ─────────────────────────────────────────────────────────────────────────────
main() {
    load_env

    local command="${1:-help}"
    shift || true

    # Parse --project flag and positional args from remaining args
    local project="${OMNIA_PROJECT_NAME:-project_default}"
    local positional_args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --project|-p)
                project="${2:-project_default}"
                shift 2 || { echo -e "${RED}--project requires a value${NC}"; exit 1; }
                ;;
            *)
                positional_args+=("$1")
                shift
                ;;
        esac
    done

    # For commands that don't need a domain arg, first positional is project
    # For edit/logs, first positional is domain
    case "$command" in
        status)
            [ "${#positional_args[@]}" -gt 0 ] && project="${positional_args[0]}"
            cmd_status "$project"
            ;;
        check)
            [ "${#positional_args[@]}" -gt 0 ] && project="${positional_args[0]}"
            cmd_check "$project"
            ;;
        repo-manager|repo_manager)
            [ "${#positional_args[@]}" -gt 0 ] && project="${positional_args[0]}"
            cmd_repo_manager "$project"
            ;;
        image-build|image_build|image-build-manager|image_build_manager)
            [ "${#positional_args[@]}" -gt 0 ] && project="${positional_args[0]}"
            cmd_image_build "$project"
            ;;
        edit)
            if [ "${#positional_args[@]}" -eq 0 ]; then
                echo -e "${RED}edit requires a domain argument${NC}"
                echo -e "Usage: omnia-cli edit <domain> [--project <name>]"
                echo -e "Domains: repo-manager, image-build, orchestrator, discovery, telemetry, build-stream"
                exit 1
            fi
            local domain
            domain=$(_domain_from_arg "${positional_args[0]}")
            if [ -z "$domain" ]; then
                echo -e "${RED}Unknown domain: ${positional_args[0]}${NC}"
                exit 1
            fi
            [ "${#positional_args[@]}" -gt 1 ] && project="${positional_args[1]}"
            cmd_edit "$domain" "$project"
            ;;
        logs|log)
            if [ "${#positional_args[@]}" -eq 0 ]; then
                echo -e "${RED}logs requires a domain argument${NC}"
                echo -e "Usage: omnia-cli logs <domain> [--project <name>]"
                echo -e "Domains: repo-manager, image-build, orchestrator, discovery, telemetry, build-stream"
                exit 1
            fi
            local domain
            domain=$(_domain_from_arg "${positional_args[0]}")
            if [ -z "$domain" ]; then
                echo -e "${RED}Unknown domain: ${positional_args[0]}${NC}"
                exit 1
            fi
            [ "${#positional_args[@]}" -gt 1 ] && project="${positional_args[1]}"
            cmd_logs "$domain" "$project"
            ;;
        version|--version|-v)
            cmd_version
            ;;
        help|--help|-h)
            if [ "${#positional_args[@]}" -gt 0 ]; then
                local domain
                domain=$(_domain_from_arg "${positional_args[0]}")
                if [ -n "$domain" ]; then
                    show_domain_help "$domain"
                else
                    echo -e "${RED}Unknown domain: ${positional_args[0]}${NC}"
                    show_help
                fi
            else
                show_help
            fi
            ;;
        *)
            # Try as a domain name
            local domain
            domain=$(_domain_from_arg "$command")
            if [ -n "$domain" ]; then
                [ "${#positional_args[@]}" -gt 0 ] && project="${positional_args[0]}"
                cmd_domain_status "$domain" "$project"
            else
                echo -e "${RED}Unknown command: ${command}${NC}"
                echo ""
                show_help
                exit 1
            fi
            ;;
    esac
}

main "$@"
