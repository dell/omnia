# =============================================================================
# omnia-cli — Omnia Domain Status & Diagnostics CLI
# =============================================================================
#
# Separated from omnia.sh to keep the main entrypoint clean.
# omnia.sh handles setup (venv, env). This CLI handles status & diagnostics.
#
# NOTE: This script requires GNU coreutils (find -printf, stat -c)
#       and is designed for RHEL/Rocky Linux on Dell infrastructure.
#
# Usage:
#   ./omnia-cli status [--project <name>]
#   ./omnia-cli check [--project <name>]
#   ./omnia-cli edit <domain> [file] [--project <name>]
#   ./omnia-cli logs <domain> [--project <name>] [--limit <n>]
#   ./omnia-cli repo_manager [--project <name>]
#   ./omnia-cli image_build_manager [--project <name>]
#   ./omnia-cli <domain> [--project <name>]
#   ./omnia-cli version
#   ./omnia-cli help [<domain>]
# =============================================================================

set -uo pipefail

# Require Bash 4.4+ for safe empty-array expansion under set -u
if ((BASH_VERSINFO[0] < 4)) || { ((BASH_VERSINFO[0] == 4)) && ((BASH_VERSINFO[1] < 4)); }; then
    echo "Error: omnia-cli requires Bash 4.4+. Current: ${BASH_VERSION}" >&2
    exit 1
fi

