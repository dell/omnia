# Exclude build_stream app directory from container image
# The app/ directory is deployed to NFS by the deploy_bsm role at runtime
../../build_stream/app/

# Exclude test directories and cache files
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.coverage
**/htmlcov/
**/*.pyc
**/*.pyo
**/*.pyd
.Python
**/.venv/
**/venv/

# Exclude git metadata
**/.git/
**/.gitignore

# Exclude IDE and editor files
**/.vscode/
**/.idea/
**/*.swp
**/*.swo
**/*~

# Exclude build artifacts
**/dist/
**/build/
**/*.egg-info/
