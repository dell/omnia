# openchami.env — managed by deploy_openchami role
#
# Environment variables consumed by OpenCHAMI Podman quadlet containers.
# Re-generated on every deploy; site-specific values come from Ansible vars.

# POSTGRESQL
POSTGRES_USER=ochami

# SMD - State Management Database
SMD_DBHOST={{ smd_dbhost }}
SMD_DBPORT={{ smd_dbport }}
SMD_DBNAME={{ smd_dbname }}
SMD_DBUSER={{ smd_dbuser }}
SMD_DBOPTS={{ smd_dbopts }}
SMD_JWKS_URL=http://tokensmith:8080/.well-known/jwks.json
SMD_AUTH_BACKEND=tokensmith
SMD_AUTH_ISSUER=http://tokensmith:8080
SMD_AUTH_AUDIENCES=smd
SMD_URL=http://smd:27779
HSM_URL=http://smd:27779

# Tokensmith - Token Broker & JWT Handler
TOKENSMITH_ISSUER=http://tokensmith:8080
TOKENSMITH_CLUSTER_ID={{ cluster_name }}-cluster
TOKENSMITH_OPENCHAMI_ID={{ cluster_name }}-openchami
TOKENSMITH_CONFIG=/etc/tokensmith/config.json
TOKENSMITH_KEY_DIR=/tokensmith/data/keys
TOKENSMITH_RFC8693_BOOTSTRAP_STORE=/tokensmith/data/bootstrap
TOKENSMITH_RFC8693_REFRESH_STORE=/tokensmith/data/refresh
TOKENSMITH_OIDC_PROVIDER={{ tokensmith_oidc_provider | default('http://hydra:4444') }}
TOKENSMITH_PORT=8080

# ACME - Smallstep - Automated Certificate Management Environment
STEPPATH=/home/step
DOCKER_STEPCA_INIT_NAME=OpenCHAMI
DOCKER_STEPCA_INIT_DNS_NAMES=step-ca,step-ca.{{ cluster_domain }}
DOCKER_STEPCA_INIT_ACME=true
DOCKER_STEPCA_INIT_PASSWORD="{{ stepca_init_password | default('supersecretpassword') }}"
DOCKER_STEPCA_INIT_PROVISIONER_NAME="{{ stepca_init_provisioner_name | default('Admin') }}"
DOCKER_STEPCA_INIT_PROVISIONER_PASSWORD="{{ stepca_init_provisioner_password | default('provisionerpassword') }}"

# MISC
ANSIBLE_HOST_KEY_CHECKING=False
TOKENSMITH_URL=http://tokensmith:8080
