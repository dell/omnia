# {{ ansible_managed }}
# Quadlet container unit for omnia_auth (OpenLDAP)

[Unit]
Description=Omnia OpenLDAP Authentication Service
After=network-online.target
Wants=network-online.target

[Container]
Image={{ omnia_auth_image }}:{{ omnia_auth_tag }}
ContainerName={{ omnia_auth_container_name }}
PublishPort={{ ldap_port }}:389
PublishPort={{ ldaps_port }}:636
Volume={{ auth_config_dir }}/slapd.conf:/etc/openldap/slapd.conf:ro,Z
Volume={{ auth_init_dir }}/bootstrap.ldif:/container-init/bootstrap.ldif:ro,Z
Volume={{ auth_init_dir }}/bootstrap.ldif.sha256:/container-init/bootstrap.ldif.sha256:ro,Z
Volume={{ auth_certs_dir }}:/etc/openldap/certs:ro,Z
Volume={{ auth_data_dir }}:/var/lib/openldap/openldap-data:Z
{% if ldap_tls_ca_file | length > 0 %}
Environment=LDAP_TLS_CA_FILE=/etc/openldap/certs/{{ ldap_tls_ca_file }}
{% endif %}
{% if ldap_tls_cert_sha256 | length > 0 %}
Environment=LDAP_TLS_CERT_SHA256={{ ldap_tls_cert_sha256 }}
{% endif %}
AutoUpdate=registry
HealthCmd=ldapwhoami -x -H ldap://127.0.0.1:389
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target default.target
