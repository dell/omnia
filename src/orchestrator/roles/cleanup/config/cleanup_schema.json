{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orchestrator Cleanup Configuration Schema",
  "description": "Schema for orchestrator cleanup component configuration",
  "type": "object",
  "properties": {
    "cleanup_components": {
      "type": "object",
      "description": "Cleanup components configuration",
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether this component is enabled for cleanup"
            },
            "priority": {
              "type": "integer",
              "description": "Execution priority (higher = earlier)",
              "minimum": 0,
              "maximum": 100
            },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "List of component dependencies"
            },
            "requires_confirmation": {
              "type": "boolean",
              "description": "Whether this component requires user confirmation"
            },
            "confirmation_token": {
              "type": "string",
              "description": "Token required for confirmation"
            },
            "rollback_supported": {
              "type": "boolean",
              "description": "Whether this component supports rollback"
            },
            "preserve": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Paths/directories to preserve during cleanup"
            },
            "cleanup_paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Paths to clean up"
            },
            "nfs_cleanup": {
              "type": "boolean",
              "description": "Whether this component performs NFS cleanup"
            },
            "unmount_mounts": {
              "type": "boolean",
              "description": "Whether this component unmounts NFS mounts"
            },
            "cleanup_node_ips": {
              "type": "boolean",
              "description": "Whether to cleanup IP-based node directories"
            }
          },
          "required": ["enabled", "priority"],
          "additionalProperties": false
        }
      }
    }
  },
  "required": ["cleanup_components"],
  "additionalProperties": false
}