#!/bin/bash
# diskless-etcd-mount.sh
# Mounts the existing etcd disk. Serial from per-node NFS conf if present, else legacy BOSS/fallback.
# NO wipe, NO format — safe for running clusters, runs every reboot
set -uo pipefail

MOUNT="/var/lib/etcd"
LOG="/var/log/diskless-etcd-mount.log"
exec > >(tee -a "$LOG") 2>&1

# ── Helpers ───────────────────────────────────────────────────────────────────
ts() { date +%F_%T; }
die() { echo "$(ts) [ERROR] $*"; exit 1; }

run() {
    echo "$(ts) [CMD] $*"
    "$@"
    local rc=$?
    echo "$(ts) [RC=$rc] $*"
    return $rc
}

runq() {
    echo "$(ts) [CMD] $* (ok to fail)"
    "$@" 2>&1 || true
}

ping_uuid() {
    local uuid
    uuid=$(blkid -s UUID -o value "$1" 2>/dev/null || true)
    echo "$(ts) [UUID] $1 = ${uuid:-NOT_FOUND}"
}

dump_fstab_entry() {
    echo "$(ts) [FSTAB] grep for $1:"
    grep "$1" /etc/fstab || echo "$(ts) [FSTAB] no entry"
}

# ── START ─────────────────────────────────────────────────────────────────────
echo ""
echo "$(ts) [INFO] ===== START diskless-update-etcd-mount-fstab ====="
echo "$(ts) [INFO] NO wipe | NO format | detect → mount → fstab"
echo "Loading Drivers"
modprobe nvme
modprobe ahci
modprobe sd_mod
modprobe megaraid_sas
echo "Drivers Loaded"
sleep 20

# ── Detect root disk ─────────────────────────────────────────────────────────
echo "$(ts) [STEP] Detecting root disk"
ROOT_DISK=$(lsblk -slno NAME,TYPE "$(findmnt -no SOURCE /)" 2>/dev/null | awk '$2=="disk"{print $1; exit}' || true)
echo "$(ts) [INFO] Root disk: ${ROOT_DISK:-none (diskless)}"

# ── Select etcd disk: pinned serial (preferred), else adopt existing etcd_data
# Device names (sdX) reorder across reboots, so selection is by stable serial
# from the per-node NFS pin. The pin is written by etcd-disk-setup.sh at
# preparation time (and self-healed below if missing).
OIM_IP="{{ k8s_nfs_server_path.split(':')[0] }}"
NODE_IP=$(ip -4 -o route get "$OIM_IP" 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="src") print $(i+1)}')
CONF="{{ k8s_client_mount_path }}/${NODE_IP}/etcd/etcd-disk.conf"
DISK=""
PINNED=0

if [ -r "$CONF" ]; then
    . "$CONF"
    : "${ETCD_DISK_SERIAL:?missing in $CONF}" "${ETCD_UUID:?missing in $CONF}"
    echo "$(ts) [STEP] Serial mode: node=$NODE_IP conf=$CONF serial=$ETCD_DISK_SERIAL"
    MATCHES=$(lsblk -dno NAME,SERIAL | awk -v s="$ETCD_DISK_SERIAL" '$2==s{print "/dev/"$1}')
    [ "$(echo "$MATCHES" | grep -c .)" -eq 1 ] || die "serial $ETCD_DISK_SERIAL matched: ${MATCHES:-nothing}"
    DISK=$MATCHES
    PINNED=1
else
    echo "$(ts) [STEP] No pin ($CONF) — adopt mode (no device-name scan)"
    if mountpoint -q "$MOUNT"; then
        # Something already mounted etcd (e.g. `mount -av`); adopt that disk.
        src=$(findmnt -no SOURCE "$MOUNT")
        DISK="/dev/$(lsblk -no PKNAME "$src" 2>/dev/null | head -1)"
        echo "$(ts) [INFO] Adopting currently-mounted etcd disk: $DISK ($src)"
    else
        # Otherwise require exactly one ext4 partition labelled etcd_data.
        mapfile -t ETCD_PARTS < <(blkid -o device -t LABEL=etcd_data 2>/dev/null || true)
        if [ "${#ETCD_PARTS[@]}" -eq 1 ]; then
            DISK="/dev/$(lsblk -no PKNAME "${ETCD_PARTS[0]}" 2>/dev/null | head -1)"
            echo "$(ts) [INFO] Found single etcd_data disk: $DISK"
        elif [ "${#ETCD_PARTS[@]}" -eq 0 ]; then
            echo "$(ts) [INFO] No etcd_data disk present yet — prepare step will format it. Exiting 0."
            exit 0
        else
            die "Multiple etcd_data partitions (${ETCD_PARTS[*]}) and no pin — refusing to guess; run etcd-disk-setup to pin"
        fi
    fi
fi

[ -z "$DISK" ] && die "No etcd disk selected"
[ "$DISK" = "/dev/${ROOT_DISK:-}" ] && die "Selected disk is root — refusing"
echo "$(ts) [OK] Selected disk: $DISK"

# ── Identify partition (by partition table, never by device-name guess) ──────
echo "$(ts) [STEP] Identifying partition on $DISK"
PART=$(lsblk -lno NAME,TYPE "$DISK" | awk '$2=="part"{print "/dev/"$1; exit}')
[ -b "${PART:-}" ] || die "${PART:-no partition} does not exist — disk must be pre-formatted"
echo "$(ts) [OK] Partition found: $PART"

# ── Get UUID and filesystem type ─────────────────────────────────────────────
echo "$(ts) [STEP] Reading UUID and filesystem type"
ping_uuid "$PART"
UUID=$(blkid -s UUID -o value "$PART" 2>/dev/null || true)
FSTYPE=$(blkid -s TYPE -o value "$PART" 2>/dev/null || true)
[ -z "$UUID" ]   && die "No UUID on $PART — is it formatted?"
[ -z "$FSTYPE" ] && die "No filesystem on $PART"
[ "$FSTYPE" = ext4 ] || die "$PART is $FSTYPE, expected ext4"
[ -n "${ETCD_UUID:-}" ] && [ "$UUID" != "$ETCD_UUID" ] && die "UUID mismatch on $PART: got $UUID, conf expects $ETCD_UUID"
echo "$(ts) [OK] UUID=$UUID  FSTYPE=$FSTYPE"

# ── Mount ────────────────────────────────────────────────────────────────────
echo "$(ts) [STEP] Mounting $MOUNT"
run mkdir -p "$MOUNT"
if mountpoint -q "$MOUNT"; then
    if [ -n "${ETCD_DISK_SERIAL:-}" ] && [ "$(findmnt -no SOURCE "$MOUNT")" != "$PART" ]; then
        die "$MOUNT already mounted from $(findmnt -no SOURCE "$MOUNT"), expected $PART"
    fi
    echo "$(ts) [OK] $MOUNT already mounted — skipping"
else
    run mount -o defaults,noatime "$PART" "$MOUNT"
    mountpoint -q "$MOUNT" || die "Mount failed"
    echo "$(ts) [OK] Mounted: $PART -> $MOUNT"
fi

# ── Dynamic fstab update (diskless: rebuilt every boot) ──────────────────────
echo "$(ts) [STEP] Updating /etc/fstab (diskless — fresh every boot)"
sed -i "\|[[:space:]]${MOUNT}[[:space:]]|d" /etc/fstab
FSTAB_LINE="UUID=$UUID $MOUNT $FSTYPE defaults,noatime,nofail 0 2"
echo "$FSTAB_LINE" >> /etc/fstab
echo "$(ts) [OK] fstab entry written: $FSTAB_LINE"
dump_fstab_entry "$MOUNT"
runq systemctl daemon-reload

# ── Persist the pin so every later boot mounts by serial, not device name ────
# Self-heals clusters provisioned before serial pinning existed: once the
# correct disk is mounted, record its serial+UUID on NFS for future boots.
if [ "$PINNED" -ne 1 ]; then
    SERIAL=$(lsblk -dno SERIAL "$DISK" 2>/dev/null | xargs || true)
    if [ -n "$SERIAL" ] && mkdir -p "$(dirname "$CONF")" 2>/dev/null; then
        printf 'ETCD_DISK_SERIAL=%s\nETCD_UUID=%s\n' "$SERIAL" "$UUID" > "$CONF"
        echo "$(ts) [OK] Wrote etcd pin: $CONF (serial=$SERIAL uuid=$UUID)"
    else
        echo "$(ts) [WARN] Could not persist pin (serial='${SERIAL:-}', $CONF) — will retry next boot"
    fi
fi

# ── etcd permissions ─────────────────────────────────────────────────────────
echo "$(ts) [STEP] Setting etcd permissions"
getent group etcd >/dev/null || run groupadd --system etcd
id etcd >/dev/null 2>&1     || run useradd --system -M -s /sbin/nologin -g etcd etcd

if id etcd >/dev/null 2>&1; then
    run chown etcd:etcd "$MOUNT"
    run chmod 700 "$MOUNT"
    echo "$(ts) [OK] Permissions set: etcd:etcd 700"
else
    echo "$(ts) [WARN] etcd user could not be created — skipping chown"
fi

# ── Final Summary ────────────────────────────────────────────────────────────
echo ""
echo "$(ts) [INFO] ── Summary ──"
echo "$(ts) [INFO] Disk:      $DISK"
echo "$(ts) [INFO] Partition: $PART"
echo "$(ts) [INFO] UUID:      $UUID"
echo "$(ts) [INFO] FS Type:   $FSTYPE"
echo "$(ts) [INFO] Mount:     $MOUNT"
echo ""
df -h "$MOUNT"
echo ""
ping_uuid "$PART"
dump_fstab_entry "$MOUNT"
echo ""
echo "$(ts) [OK] ===== DONE ====="
