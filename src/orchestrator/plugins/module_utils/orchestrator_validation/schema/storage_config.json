{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orchestrator storage configuration",
  "type": "object",
  "properties": {
    "mounts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/mount"
      }
    },
    "mount_params": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/mountProfile"
      }
    },
    "powervault_config": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/powerVault"
      }
    },
    "swap": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/swap"
      }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/"
    },
    "targetList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "owner": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "group": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{3,4}$"
        }
      },
      "additionalProperties": false
    },
    "mount": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/name"
        },
        "source": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "mount_point": {
          "$ref": "#/definitions/absolutePath"
        },
        "mount_params": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "fs_type": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "mnt_opts": {
          "type": "string"
        },
        "dump_freq": {
          "type": ["string", "integer"],
          "pattern": "^[0-2]$"
        },
        "fsck_pass": {
          "type": ["string", "integer"],
          "pattern": "^[0-9]$"
        },
        "mount_on_oim": {
          "type": "boolean"
        },
        "node_key": {
          "enum": ["local_hostname", "local_ipv4", "instance_id"]
        },
        "node_mount_point": {
          "$ref": "#/definitions/targetList"
        },
        "functional_group_prefix": {
          "$ref": "#/definitions/targetList"
        },
        "groups": {
          "$ref": "#/definitions/targetList"
        },
        "permissions": {
          "$ref": "#/definitions/permissions"
        }
      },
      "required": ["name", "source", "mount_point"],
      "oneOf": [
        {
          "required": ["functional_group_prefix"],
          "not": {
            "required": ["groups"]
          }
        },
        {
          "required": ["groups"],
          "not": {
            "required": ["functional_group_prefix"]
          }
        }
      ],
      "dependencies": {
        "node_key": ["node_mount_point"]
      },
      "additionalProperties": false
    },
    "mountProfile": {
      "type": "object",
      "properties": {
        "fs_type": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "mnt_opts": {
          "type": "string"
        },
        "dump_freq": {
          "type": ["string", "integer"]
        },
        "fsck_pass": {
          "type": ["string", "integer"]
        }
      },
      "required": ["fs_type", "mnt_opts"],
      "additionalProperties": false
    },
    "powerVault": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/name"
        },
        "ip": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "ipv4"
          }
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "iscsi_initiator": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "volume_id": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]+$"
        },
        "mount_point": {
          "$ref": "#/definitions/absolutePath"
        },
        "mount_params": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "fs_type": {
          "$ref": "#/definitions/nonEmptyString"
        },
        "mnt_opts": {
          "type": "string"
        },
        "dump_freq": {
          "type": ["string", "integer"]
        },
        "fsck_pass": {
          "type": ["string", "integer"]
        },
        "node_key": {
          "enum": ["local_hostname", "local_ipv4", "instance_id"]
        },
        "node_mount_point": {
          "$ref": "#/definitions/targetList"
        },
        "functional_group_prefix": {
          "$ref": "#/definitions/targetList"
        },
        "permissions": {
          "$ref": "#/definitions/permissions"
        }
      },
      "required": [
        "name",
        "ip",
        "iscsi_initiator",
        "volume_id",
        "mount_point",
        "functional_group_prefix"
      ],
      "dependencies": {
        "node_key": ["node_mount_point"]
      },
      "additionalProperties": false
    },
    "swap": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/name"
        },
        "filename": {
          "$ref": "#/definitions/absolutePath"
        },
        "size": {
          "type": ["string", "integer"]
        },
        "maxsize": {
          "type": ["string", "integer"]
        },
        "functional_group_prefix": {
          "$ref": "#/definitions/targetList"
        }
      },
      "required": ["filename", "size", "functional_group_prefix"],
      "additionalProperties": false
    }
  }
}
