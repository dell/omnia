# PXE Boot Inventory File
# Format: INI with host variables
#
# Required fields:
#   - BMC IP as hostname (iDRAC management IP)
#   - admin_ip: Node's admin/data network IP (for phone-home verification)
#   - hostname: Node's hostname (for reporting)
#
# Optional fields:
#   - service_tag: Dell service tag (for tracking)

[bmc]
172.16.0.73 admin_ip=172.16.1.50 hostname=node01 service_tag=ABC123
172.16.0.74 admin_ip=172.16.1.51 hostname=node02 service_tag=DEF456
172.16.0.75 admin_ip=172.16.1.52 hostname=node03 service_tag=GHI789

# Alternative: Group variables (applies to all hosts in [bmc])
# [bmc:vars]
# ansible_connection=local
