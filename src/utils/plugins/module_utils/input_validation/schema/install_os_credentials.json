{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Install OS Credentials Schema",
  "description": "Schema for install_os_credentials.yml - OS installation credentials",
  "type": "object",
  "properties": {
    "bmc_username": {
      "type": "string",
      "description": "BMC/iDRAC username for target node"
    },
    "bmc_password": {
      "type": "string",
      "description": "BMC/iDRAC password for target node"
    },
    "os_root_password": {
      "type": "string",
      "description": "Root password for the installed OS"
    }
  },
  "required": ["bmc_username", "bmc_password", "os_root_password"]
}
