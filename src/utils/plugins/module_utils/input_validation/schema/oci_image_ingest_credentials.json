{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OCI Image Ingest Credentials Schema",
  "description": "Schema for the decrypted oci_image_ingest_credentials.yml: top-level scalars registry_username and registry_password.",
  "type": "object",
  "required": [
    "registry_username",
    "registry_password"
  ],
  "additionalProperties": false,
  "properties": {
    "registry_username": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"
    },
    "registry_password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    }
  }
}
