# Configure PowerScale syslog forwarding to VLAgent
# This script reads PowerScale cluster credentials from CSI driver secret
# and configures syslog forwarding to VLAgent (LoadBalancer or NodePort)

set -e

NAMESPACE="{{ telemetry_namespace }}"
CSI_SECRET_PATH="{{ csi_powerscale_driver_secret_file_path }}"
K8S_MASTER_IP="{{ kube_vip }}"

echo "=========================================="
echo "PowerScale Syslog Configuration"
echo "=========================================="

# Get VLAgent service configuration
echo "Getting VLAgent service configuration..."
VLAGENT_SERVICE=$(kubectl get svc vlagent-vlagent -n $NAMESPACE -o json 2>/dev/null)
if [ $? -ne 0 ]; then
    echo "ERROR: VLAgent service not found in namespace $NAMESPACE"
    exit 1
fi

# Check service type
SERVICE_TYPE=$(echo "$VLAGENT_SERVICE" | jq -r '.spec.type')
echo "VLAgent service type: $SERVICE_TYPE"

# Determine syslog endpoint based on service type
if [ "$SERVICE_TYPE" == "LoadBalancer" ]; then
    echo "Using LoadBalancer external IP..."
    # Get external IP for LoadBalancer
    EXTERNAL_IP=$(echo "$VLAGENT_SERVICE" | jq -r '.status.loadBalancer.ingress[0].ip // .status.loadBalancer.ingress[0].hostname')
    
    if [ -z "$EXTERNAL_IP" ] || [ "$EXTERNAL_IP" == "null" ]; then
        echo "WARNING: LoadBalancer external IP not available yet"
        echo "Falling back to kube_vip: $K8S_MASTER_IP"
        SYSLOG_ENDPOINT="$K8S_MASTER_IP:514"
    else
        echo "LoadBalancer external IP: $EXTERNAL_IP"
        SYSLOG_ENDPOINT="$EXTERNAL_IP:514"
    fi
else
    echo "Using NodePort..."
    # Try to find syslog TCP NodePort (try multiple possible names)
    NODEPORT=$(echo "$VLAGENT_SERVICE" | jq -r '.spec.ports[] | select(.name=="syslog" and .protocol=="TCP") | .nodePort')
    if [ -z "$NODEPORT" ] || [ "$NODEPORT" == "null" ]; then
        # Try alternative port name
        NODEPORT=$(echo "$VLAGENT_SERVICE" | jq -r '.spec.ports[] | select(.name=="syslog-tcp" and .protocol=="TCP") | .nodePort')
    fi

    # If still not found, try to find any port with port 514
    if [ -z "$NODEPORT" ] || [ "$NODEPORT" == "null" ]; then
        NODEPORT=$(echo "$VLAGENT_SERVICE" | jq -r '.spec.ports[] | select(.port==514 and .protocol=="TCP") | .nodePort')
    fi

    if [ -z "$NODEPORT" ] || [ "$NODEPORT" == "null" ]; then
        echo "ERROR: Could not find syslog TCP NodePort in VLAgent service"
        echo "Available ports in service:"
        echo "$VLAGENT_SERVICE" | jq -r '.spec.ports[] | "  - \(.name): \(.port) -> \(.nodePort // "no NodePort") (\(.protocol))"'
        exit 1
    fi
    
    SYSLOG_ENDPOINT="$K8S_MASTER_IP:$NODEPORT"
fi

echo "Syslog endpoint: $SYSLOG_ENDPOINT"

# Parse CSI driver secret to get PowerScale clusters
echo "Reading PowerScale cluster credentials from CSI secret..."
if [ ! -f "$CSI_SECRET_PATH" ]; then
    echo "ERROR: CSI driver secret not found at $CSI_SECRET_PATH"
    exit 1
fi

# Extract isilonClusters from YAML
CLUSTERS=$(yq eval '.isilonClusters' "$CSI_SECRET_PATH" -o json)
CLUSTER_COUNT=$(echo "$CLUSTERS" | jq '. | length')

if [ "$CLUSTER_COUNT" -eq 0 ]; then
    echo "ERROR: No PowerScale clusters found in CSI secret"
    exit 1
fi

echo "Found $CLUSTER_COUNT PowerScale cluster(s)"
echo ""

# Configure syslog on each PowerScale cluster
SUCCESS_COUNT=0
FAIL_COUNT=0

# Check if syslog API endpoint exists on the first cluster
USE_AUDIT_SYSLOG=false
if [ "$CLUSTER_COUNT" -gt 0 ]; then
    FIRST_ENDPOINT=$(echo "$CLUSTERS" | jq -r ".[0].endpoint")
    FIRST_USER=$(echo "$CLUSTERS" | jq -r ".[0].username")
    FIRST_PASS=$(echo "$CLUSTERS" | jq -r ".[0].password")
    
    echo "Checking if syslog API endpoint is available..."
    ENDPOINT_CHECK=$(curl -s -w "\n%{http_code}" -X GET \
        "https://$FIRST_ENDPOINT:8080/platform/1/syslog/settings" \
        -u "$FIRST_USER:$FIRST_PASS" \
        -k 2>&1)
    
    HTTP_CODE=$(echo "$ENDPOINT_CHECK" | tail -n1)
    
    # Check if endpoint returns 404 (not found)
    if echo "$ENDPOINT_CHECK" | grep -q "AEC_NOT_FOUND\|Path not found\|404"; then
        echo "WARNING: General syslog configuration API endpoint not found on PowerScale cluster."
        echo "This PowerScale version does not support general syslog configuration via REST API."
        echo ""
        echo "Attempting to use audit syslog forwarding as an alternative..."
        echo ""
        USE_AUDIT_SYSLOG=true
    fi
fi

for i in $(seq 0 $(($CLUSTER_COUNT - 1))); do
    CLUSTER_NAME=$(echo "$CLUSTERS" | jq -r ".[$i].name")
    CLUSTER_ENDPOINT=$(echo "$CLUSTERS" | jq -r ".[$i].endpoint")
    CLUSTER_USER=$(echo "$CLUSTERS" | jq -r ".[$i].username")
    CLUSTER_PASS=$(echo "$CLUSTERS" | jq -r ".[$i].password")
    
    echo "Configuring cluster: $CLUSTER_NAME ($CLUSTER_ENDPOINT)"
    
    if [ "$USE_AUDIT_SYSLOG" = true ]; then
        echo "  Using audit syslog forwarding configuration..."
        
        # Check current audit syslog configuration
        AUDIT_CONFIG=$(curl -s -X GET \
            "https://$CLUSTER_ENDPOINT:8080/platform/1/audit/settings" \
            -u "$CLUSTER_USER:$CLUSTER_PASS" \
            -k 2>&1)
        
        # Check if audit syslog is already forwarding to our server
        if echo "$AUDIT_CONFIG" | grep -q "$K8S_MASTER_IP"; then
            echo "  ✓ Audit syslog already configured to forward to $K8S_MASTER_IP"
            SUCCESS_COUNT=$((SUCCESS_COUNT + 1))
            echo ""
            continue
        fi
        
        # Try to configure audit syslog remote server
        # Note: This requires the audit API to support remote server configuration
        # If not available, we'll provide manual instructions
        echo "  Attempting to configure audit syslog remote server..."
        echo "  Note: This may require manual configuration via SSH or Web UI"
        echo ""
        echo "  Manual configuration steps for this cluster:"
        echo "  1. SSH to cluster: ssh admin@$CLUSTER_ENDPOINT"
        echo "  2. Configure audit syslog to forward to: $SYSLOG_ENDPOINT"
        echo "  3. Command may be: isi audit settings modify --syslog-host=$(echo $SYSLOG_ENDPOINT | cut -d: -f1) --syslog-port=$(echo $SYSLOG_ENDPOINT | cut -d: -f2)"
        echo ""
        echo "  Skipping automated configuration for audit syslog."
        continue
    fi
    
    # Idempotency check: Get current syslog configuration
    CURRENT_CONFIG=$(curl -s -X GET \
        "https://$CLUSTER_ENDPOINT:8080/platform/1/syslog/settings" \
        -u "$CLUSTER_USER:$CLUSTER_PASS" \
        -k 2>&1)
    
    CURRENT_REMOTE_SERVER=$(echo "$CURRENT_CONFIG" | jq -r '.remote_servers[0]' 2>/dev/null || echo "")
    CURRENT_ENABLED=$(echo "$CURRENT_CONFIG" | jq -r '.enabled' 2>/dev/null || echo "false")
    
    DESIRED_REMOTE_SERVER="$SYSLOG_ENDPOINT"
    DESIRED_ENABLED="true"
    
    # Check if configuration matches desired state
    if [ "$CURRENT_REMOTE_SERVER" == "$DESIRED_REMOTE_SERVER" ] && [ "$CURRENT_ENABLED" == "$DESIRED_ENABLED" ]; then
        echo "  ✓ Syslog already configured correctly (idempotent)"
        echo "  Remote Server: $CURRENT_REMOTE_SERVER"
        echo "  Enabled: $CURRENT_ENABLED"
        SUCCESS_COUNT=$((SUCCESS_COUNT + 1))
        echo ""
        continue
    fi
    
    echo "  Current configuration differs from desired state"
    echo "  Current: $CURRENT_REMOTE_SERVER (enabled: $CURRENT_ENABLED)"
    echo "  Desired: $DESIRED_REMOTE_SERVER (enabled: $DESIRED_ENABLED)"
    
    # Configure syslog remote server
    RESPONSE=$(curl -s -w "\n%{http_code}" -X PUT \
        "https://$CLUSTER_ENDPOINT:8080/platform/1/syslog/settings" \
        -u "$CLUSTER_USER:$CLUSTER_PASS" \
        -H "Content-Type: application/json" \
        -k \
        -d "{\"remote_servers\": [\"$SYSLOG_ENDPOINT\"], \"enabled\": true}" \
        2>&1)
    
    HTTP_CODE=$(echo "$RESPONSE" | tail -n1)
    
    if [ "$HTTP_CODE" == "200" ] || [ "$HTTP_CODE" == "204" ]; then
        echo "  ✓ Syslog configuration successful"
        
        # Verify configuration
        VERIFY=$(curl -s -X GET \
            "https://$CLUSTER_ENDPOINT:8080/platform/1/syslog/settings" \
            -u "$CLUSTER_USER:$CLUSTER_PASS" \
            -k 2>&1)
        
        REMOTE_SERVER=$(echo "$VERIFY" | jq -r '.remote_servers[0]' 2>/dev/null || echo "unknown")
        ENABLED=$(echo "$VERIFY" | jq -r '.enabled' 2>/dev/null || echo "unknown")
        
        echo "  Remote Server: $REMOTE_SERVER"
        echo "  Enabled: $ENABLED"
        SUCCESS_COUNT=$((SUCCESS_COUNT + 1))
    else
        echo "  ✗ Syslog configuration failed (HTTP $HTTP_CODE)"
        echo "  Response: $(echo "$RESPONSE" | head -n-1)"
        FAIL_COUNT=$((FAIL_COUNT + 1))
    fi
    echo ""
done

echo "=========================================="
echo "Configuration Summary"
echo "=========================================="
echo "Total Clusters: $CLUSTER_COUNT"
echo "Successful: $SUCCESS_COUNT"
echo "Failed: $FAIL_COUNT"
echo ""

if [ $SUCCESS_COUNT -gt 0 ]; then
    echo "PowerScale syslog forwarding configured to: $SYSLOG_ENDPOINT"
    echo "To verify logs: kubectl -n $NAMESPACE logs -l app.kubernetes.io/name=victoria-logs-cluster -c vlagent"
fi

if [ $FAIL_COUNT -gt 0 ]; then
    echo "WARNING: Some clusters failed to configure or require manual configuration."
    echo "Check the output above for manual configuration steps."
    echo ""
    echo "Deployment will continue. Please configure syslog manually on the failed clusters."
    echo "Target syslog server: $SYSLOG_ENDPOINT"
fi

echo "PowerScale syslog configuration process completed!"
echo "Exit code: 0 (deployment will continue)"
exit 0
