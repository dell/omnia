# Configure PowerScale syslog forwarding to VLAgent
# This script reads PowerScale cluster credentials from CSI driver secret
# and configures syslog forwarding to VLAgent NodePort

set -e

NAMESPACE="{{ telemetry_namespace }}"
CSI_SECRET_PATH="{{ csi_powerscale_driver_secret_file_path }}"
K8S_MASTER_IP="{{ k8s_master_ip }}"

echo "=========================================="
echo "PowerScale Syslog Configuration"
echo "=========================================="

# Get VLAgent service NodePort
echo "Getting VLAgent service NodePort..."
VLAGENT_SERVICE=$(kubectl get svc vlagent-victoria-logs-cluster -n $NAMESPACE -o json 2>/dev/null)
if [ $? -ne 0 ]; then
    echo "ERROR: VLAgent service not found in namespace $NAMESPACE"
    exit 1
fi

NODEPORT=$(echo "$VLAGENT_SERVICE" | jq -r '.spec.ports[] | select(.name=="syslog-tcp") | .nodePort')
if [ -z "$NODEPORT" ] || [ "$NODEPORT" == "null" ]; then
    echo "ERROR: Could not find syslog-tcp NodePort in VLAgent service"
    exit 1
fi

echo "VLAgent NodePort: $K8S_MASTER_IP:$NODEPORT"

# Parse CSI driver secret to get PowerScale clusters
echo "Reading PowerScale cluster credentials from CSI secret..."
if [ ! -f "$CSI_SECRET_PATH" ]; then
    echo "ERROR: CSI driver secret not found at $CSI_SECRET_PATH"
    exit 1
fi

# Extract isilonClusters from YAML
CLUSTERS=$(yq eval '.isilonClusters' "$CSI_SECRET_PATH" -o json)
CLUSTER_COUNT=$(echo "$CLUSTERS" | jq '. | length')

if [ "$CLUSTER_COUNT" -eq 0 ]; then
    echo "ERROR: No PowerScale clusters found in CSI secret"
    exit 1
fi

echo "Found $CLUSTER_COUNT PowerScale cluster(s)"
echo ""

# Configure syslog on each PowerScale cluster
SUCCESS_COUNT=0
FAIL_COUNT=0

# Check if syslog API endpoint exists on the first cluster
if [ "$CLUSTER_COUNT" -gt 0 ]; then
    FIRST_ENDPOINT=$(echo "$CLUSTERS" | jq -r ".[0].endpoint")
    FIRST_USER=$(echo "$CLUSTERS" | jq -r ".[0].username")
    FIRST_PASS=$(echo "$CLUSTERS" | jq -r ".[0].password")
    
    echo "Checking if syslog API endpoint is available..."
    ENDPOINT_CHECK=$(curl -s -w "\n%{http_code}" -X GET \
        "https://$FIRST_ENDPOINT:8080/platform/1/syslog/settings" \
        -u "$FIRST_USER:$FIRST_PASS" \
        -k 2>&1)
    
    HTTP_CODE=$(echo "$ENDPOINT_CHECK" | tail -n1)
    
    # Check if endpoint returns 404 (not found)
    if echo "$ENDPOINT_CHECK" | grep -q "AEC_NOT_FOUND\|Path not found\|404"; then
        echo "WARNING: Syslog configuration API endpoint not found on PowerScale cluster."
        echo "This PowerScale version does not support syslog configuration via REST API."
        echo "Please configure syslog manually on each PowerScale cluster."
        echo ""
        echo "Manual configuration steps:"
        echo "1. SSH to each PowerScale cluster: ssh admin@<cluster-ip>"
        echo "2. Configure syslog using the appropriate method for your OneFS version"
        echo "3. Forward syslog to: $K8S_MASTER_IP:$NODEPORT"
        echo ""
        echo "Skipping automated syslog configuration."
        exit 0
    fi
fi

for i in $(seq 0 $(($CLUSTER_COUNT - 1))); do
    CLUSTER_NAME=$(echo "$CLUSTERS" | jq -r ".[$i].name")
    CLUSTER_ENDPOINT=$(echo "$CLUSTERS" | jq -r ".[$i].endpoint")
    CLUSTER_USER=$(echo "$CLUSTERS" | jq -r ".[$i].username")
    CLUSTER_PASS=$(echo "$CLUSTERS" | jq -r ".[$i].password")
    
    echo "Configuring cluster: $CLUSTER_NAME ($CLUSTER_ENDPOINT)"
    
    # Idempotency check: Get current syslog configuration
    CURRENT_CONFIG=$(curl -s -X GET \
        "https://$CLUSTER_ENDPOINT:8080/platform/1/syslog/settings" \
        -u "$CLUSTER_USER:$CLUSTER_PASS" \
        -k 2>&1)
    
    CURRENT_REMOTE_SERVER=$(echo "$CURRENT_CONFIG" | jq -r '.remote_servers[0]' 2>/dev/null || echo "")
    CURRENT_ENABLED=$(echo "$CURRENT_CONFIG" | jq -r '.enabled' 2>/dev/null || echo "false")
    
    DESIRED_REMOTE_SERVER="$K8S_MASTER_IP:$NODEPORT"
    DESIRED_ENABLED="true"
    
    # Check if configuration matches desired state
    if [ "$CURRENT_REMOTE_SERVER" == "$DESIRED_REMOTE_SERVER" ] && [ "$CURRENT_ENABLED" == "$DESIRED_ENABLED" ]; then
        echo "  ✓ Syslog already configured correctly (idempotent)"
        echo "  Remote Server: $CURRENT_REMOTE_SERVER"
        echo "  Enabled: $CURRENT_ENABLED"
        SUCCESS_COUNT=$((SUCCESS_COUNT + 1))
        echo ""
        continue
    fi
    
    echo "  Current configuration differs from desired state"
    echo "  Current: $CURRENT_REMOTE_SERVER (enabled: $CURRENT_ENABLED)"
    echo "  Desired: $DESIRED_REMOTE_SERVER (enabled: $DESIRED_ENABLED)"
    
    # Configure syslog remote server
    RESPONSE=$(curl -s -w "\n%{http_code}" -X PUT \
        "https://$CLUSTER_ENDPOINT:8080/platform/1/syslog/settings" \
        -u "$CLUSTER_USER:$CLUSTER_PASS" \
        -H "Content-Type: application/json" \
        -k \
        -d "{\"remote_servers\": [\"$K8S_MASTER_IP:$NODEPORT\"], \"enabled\": true}" \
        2>&1)
    
    HTTP_CODE=$(echo "$RESPONSE" | tail -n1)
    
    if [ "$HTTP_CODE" == "200" ] || [ "$HTTP_CODE" == "204" ]; then
        echo "  ✓ Syslog configuration successful"
        
        # Verify configuration
        VERIFY=$(curl -s -X GET \
            "https://$CLUSTER_ENDPOINT:8080/platform/1/syslog/settings" \
            -u "$CLUSTER_USER:$CLUSTER_PASS" \
            -k 2>&1)
        
        REMOTE_SERVER=$(echo "$VERIFY" | jq -r '.remote_servers[0]' 2>/dev/null || echo "unknown")
        ENABLED=$(echo "$VERIFY" | jq -r '.enabled' 2>/dev/null || echo "unknown")
        
        echo "  Remote Server: $REMOTE_SERVER"
        echo "  Enabled: $ENABLED"
        SUCCESS_COUNT=$((SUCCESS_COUNT + 1))
    else
        echo "  ✗ Syslog configuration failed (HTTP $HTTP_CODE)"
        echo "  Response: $(echo "$RESPONSE" | head -n-1)"
        FAIL_COUNT=$((FAIL_COUNT + 1))
    fi
    echo ""
done

echo "=========================================="
echo "Configuration Summary"
echo "=========================================="
echo "Total Clusters: $CLUSTER_COUNT"
echo "Successful: $SUCCESS_COUNT"
echo "Failed: $FAIL_COUNT"
echo ""

if [ $SUCCESS_COUNT -gt 0 ]; then
    echo "PowerScale syslog forwarding configured to: $K8S_MASTER_IP:$NODEPORT"
    echo "To verify logs: kubectl -n $NAMESPACE logs -l app.kubernetes.io/name=victoria-logs-cluster -c vlagent"
fi

if [ $FAIL_COUNT -gt 0 ]; then
    echo "WARNING: Some clusters failed to configure. Check the output above for details."
    exit 1
fi

echo "PowerScale syslog configuration completed successfully!"
