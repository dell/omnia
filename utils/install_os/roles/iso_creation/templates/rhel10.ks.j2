#version=RHEL10
# Kickstart for Omnia admin node
# Generated by Omnia utils/install_os

{% set install_disk = ks_install_disk if (ks_install_disk is defined and ks_install_disk | length > 0) else 'sda' %}

# Pre-install — clean disk signatures to prevent probe errors
%pre --log=/tmp/ks-pre.log
# Stop active RAID/LVM
mdadm --stop --scan 2>/dev/null
vgchange -an 2>/dev/null
%end

# Installation
graphical
cdrom

# Locale
lang en_US.UTF-8
keyboard --vckeymap=us --xlayouts='us'
timezone {{ ks_timezone | default('UTC') }} --utc

# Network
{% if ks_dns is defined and ks_dns | length > 0 %}
network --bootproto=static --device=link --ip={{ ks_static_ip }} --netmask={{ ks_netmask }} --gateway={{ ks_gateway }} --nameserver={{ ks_dns }} --hostname={{ ks_hostname | default('admin-node') }} --activate --onboot=yes
{% else %}
network --bootproto=static --device=link --ip={{ ks_static_ip }} --netmask={{ ks_netmask }}{% if ks_gateway is defined and ks_gateway | length > 0 %} --gateway={{ ks_gateway }}{% endif %} --hostname={{ ks_hostname | default('admin-node') }} --activate --onboot=yes
{% endif %}

# Authentication
rootpw --iscrypted {{ ks_root_password_hash }}
{% if ks_ssh_public_key is defined and ks_ssh_public_key | length > 0 %}
sshkey --username=root "{{ ks_ssh_public_key }}"
{% endif %}

# Bootloader
bootloader --append="crashkernel=auto" --boot-drive={{ install_disk }}

# Disk partitioning
ignoredisk --only-use={{ install_disk }}
zerombr
clearpart --drives={{ install_disk }} --all --initlabel
autopart

# System
eula --agreed
firstboot --disabled
selinux --enforcing
firewall --enabled --ssh
services --enabled=sshd,NetworkManager,gdm

# Kdump
%addon com_redhat_kdump --enable --reserve-mb='auto'
%end

# Reboot
reboot --eject

# Packages
repo --name="AppStream" --baseurl=file:///run/install/repo/AppStream

%packages
@^graphical-server-environment
@development
@headless-management
%end

# Post-install
%post --log=/root/ks-post.log
sed -i 's/^#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
sed -i 's/^PermitRootLogin no/PermitRootLogin yes/' /etc/ssh/sshd_config
systemctl set-default graphical.target
echo "KS_COMPLETE=$(date -u +%Y%m%dT%H%M%SZ)" > /root/.ks-complete
%end
