#version=RHEL10
# Kickstart for Omnia admin node
# Generated by Omnia utils/install_os

# Pre-install — clean disk signatures to prevent probe errors
%pre --log=/tmp/ks-pre.log
# Stop active RAID/LVM
mdadm --stop --scan 2>/dev/null
vgchange -an 2>/dev/null

# Clean all disks
for disk in /dev/nvme[0-9]n[0-9] /dev/sd[a-z] /dev/vd[a-z]; do
    if [ -b "$disk" ]; then
        for part in ${disk}p* ${disk}[0-9]*; do
            if [ -b "$part" ]; then
                mdadm --zero-superblock "$part" 2>/dev/null
                wipefs --all --force "$part" 2>/dev/null
                dd if=/dev/zero of="$part" bs=1M count=1 2>/dev/null
            fi
        done
        mdadm --zero-superblock "$disk" 2>/dev/null
        wipefs --all --force "$disk" 2>/dev/null
        dd if=/dev/zero of="$disk" bs=1M count=10 2>/dev/null
        size=$(blockdev --getsz "$disk" 2>/dev/null)
        if [ -n "$size" ]; then
            dd if=/dev/zero of="$disk" bs=512 count=34 seek=$((size - 34)) 2>/dev/null
        fi
    fi
done
partprobe 2>/dev/null
udevadm settle 2>/dev/null
%end

# Installation
text
cdrom

# Locale
lang en_US.UTF-8
keyboard --vckeymap=us --xlayouts='us'
timezone {{ ks_timezone | default('UTC') }} --utc

# Network
{% if ks_dns is defined and ks_dns | length > 0 %}
network --bootproto=static --device=link --ip={{ ks_static_ip }} --netmask={{ ks_netmask }} --gateway={{ ks_gateway }} --nameserver={{ ks_dns }} --hostname={{ ks_hostname | default('admin-node') }} --activate --onboot=yes
{% else %}
network --bootproto=static --device=link --ip={{ ks_static_ip }} --netmask={{ ks_netmask }}{% if ks_gateway is defined and ks_gateway | length > 0 %} --gateway={{ ks_gateway }}{% endif %} --hostname={{ ks_hostname | default('admin-node') }} --activate --onboot=yes
{% endif %}

# Authentication
rootpw --iscrypted {{ ks_root_password_hash }}
{% if ks_ssh_public_key is defined and ks_ssh_public_key | length > 0 %}
sshkey --username=root "{{ ks_ssh_public_key }}"
{% endif %}

# Bootloader — auto-detect, works on x86_64 and AArch64
{% if ks_install_disk is defined and ks_install_disk | length > 0 %}
bootloader --append="crashkernel=auto" --boot-drive={{ ks_install_disk }}
{% else %}
bootloader --append="crashkernel=auto"
{% endif %}

# Disk partitioning
{% if ks_install_disk is defined and ks_install_disk | length > 0 %}
ignoredisk --only-use={{ ks_install_disk }}
zerombr
clearpart --all --initlabel --drives={{ ks_install_disk }}
{% else %}
zerombr
clearpart --all --initlabel
{% endif %}
autopart --type=lvm

# System
eula --agreed
firstboot --disabled
selinux --enforcing
firewall --enabled --ssh
services --enabled=sshd,NetworkManager

# Kdump
%addon com_redhat_kdump --enable --reserve-mb='auto'
%end

# Reboot
reboot --eject

# Packages
repo --name="AppStream" --baseurl=file:///run/install/repo/AppStream

%packages
@^graphical-server-environment
@development
@headless-management
%end

# Post-install
%post --log=/root/ks-post.log
sed -i 's/^#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
sed -i 's/^PermitRootLogin no/PermitRootLogin yes/' /etc/ssh/sshd_config
echo "KS_COMPLETE=$(date -u +%Y%m%dT%H%M%SZ)" > /root/.ks-complete
%end
