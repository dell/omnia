#version=RHEL10
# Kickstart for admin_aarch64 builder node
# Generated by Omnia utils/install_os

# Installation method
cdrom

# System language and keyboard
lang en_US.UTF-8
keyboard us

# Network configuration — static admin/PXE IP
{% if ks_network_device | length > 0 %}
network --bootproto=static --device={{ ks_network_device }} --ip={{ ks_static_ip }} --netmask={{ ks_netmask }}{% if ks_gateway | length > 0 %} --gateway={{ ks_gateway }}{% endif %}{% if ks_dns | length > 0 %} --nameserver={{ ks_dns }}{% endif %} --activate --onboot=yes --hostname={{ ks_hostname }}
{% else %}
network --bootproto=static --ip={{ ks_static_ip }} --netmask={{ ks_netmask }}{% if ks_gateway | length > 0 %} --gateway={{ ks_gateway }}{% endif %}{% if ks_dns | length > 0 %} --nameserver={{ ks_dns }}{% endif %} --activate --onboot=yes --hostname={{ ks_hostname }}
{% endif %}

# Root password (SHA-512 hash from provision_password)
rootpw --iscrypted {{ ks_root_password_hash }}

# SSH key injection for OIM access
sshkey --username=root "{{ ks_ssh_public_key }}"

# Timezone
timezone {{ ks_timezone }} --utc

# Bootloader
bootloader --append="crashkernel=auto" --location=mbr

# Disk partitioning — use entire disk
clearpart --all --initlabel
autopart --type=lvm

# SELinux
selinux --enforcing

# Firewall
firewall --enabled --ssh

# Services
services --enabled=sshd,NetworkManager

# Base environment: Server with GUI
@^graphical-server-environment

# Reboot after installation
reboot --eject

# Post-install script
%post --log=/root/ks-post.log
# Enable SSH root login
sed -i 's/^#*PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
systemctl enable sshd
systemctl restart sshd

# Set default target to multi-user (can be changed later)
systemctl set-default multi-user.target
%end
