{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["dns_config"],
  "properties": {
    "dns_config": {
      "type": "object",
      "required": [
        "dns_enabled",
        "dns_domain"
      ],
      "properties": {
        "dns_enabled": { "type": "boolean" },
        "dns_domain": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9\\-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9\\-]*[a-z0-9])?)*$"
        }
      },
      "additionalProperties": false
    }
  }
}
