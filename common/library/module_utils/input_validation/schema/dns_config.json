{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["dns_config"],
  "properties": {
    "dns_config": {
      "type": "object",
      "required": [
        "dns_enabled",
        "dns_domain",
        "dns_ttl",
        "dns_reverse_enabled",
        "dns_cache_ttl"
      ],
      "properties": {
        "dns_enabled": { "type": "boolean" },
        "dns_domain": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9\\-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9\\-]*[a-z0-9])?)*$"
        },
        "dns_ttl": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "dns_reverse_enabled": { "type": "boolean" },
        "dns_fabric_suffixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^-[a-z0-9][a-z0-9\\-]*$"
          }
        },
        "dns_cache_ttl": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        },
        "dns_soa": {
          "type": "object",
          "properties": {
            "refresh": { "type": "integer", "minimum": 1 },
            "retry": { "type": "integer", "minimum": 1 },
            "expire": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
